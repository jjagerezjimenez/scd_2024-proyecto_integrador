    comment: ''
    value: len(payload_B)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 268]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    sym_map: '[0, 1, 3, 2]'
    rot_sym: '4'
    real_sect: '2'
    imag_sect: '2'
    w_real_sect: '1'
    w_imag_sect: '1'
    precision: '8'
    soft_dec_lut: None
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 108]
    rotation: 0
    state: enabled
- name: formato_trama
  id: variable_header_format_default
  parameters:
    comment: ''
    access_code: '0'
    threshold: '0'
    bps: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 188]
    rotation: 0
    state: enabled
- name: umbral
  id: variable
  parameters:
    comment: Bits erróneos tolerados al buscar el preámbulo de 64 bits
    value: '12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 268]
    rotation: 0
    state: enabled
- name: ruido
  id: variable
  parameters:
    comment: 'Desvío del ruido complejo: potencia de señal = 1 por muestra, Es/N0 = 2 Eb/N0'
    value: math.sqrt(sps / (2 * 10**(ebn0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 108]
    rotation: 0
    state: enabled
