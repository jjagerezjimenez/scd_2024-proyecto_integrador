    value: '0.005'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [592, 12]
    rotation: 0
    state: enabled
- name: sync_bw
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: BW del sincronismo de simbolo
    short_id: ''
    type: eng_float
    value: '0.01'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [728, 12]
    rotation: 0
    state: enabled
- name: muestras
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Muestras del canal compartido
    short_id: ''
    type: intx
    value: '4000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 12]
    rotation: 0
    state: enabled
- name: semilla
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Semilla del ruido
    short_id: ''
    type: intx
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 12]
    rotation: 0
    state: enabled
- name: descartar
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Bits descartados al inicio (enganche de los lazos)
    short_id: ''
    type: intx
    value: '100000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1136, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Frecuencia de muestreo [muestras/s]
    value: '500000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 108]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: Muestras por símbolo
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 108]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: Factor de roll-off del filtro RRC
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 108]
    rotation: 0
    state: enabled
- name: ranura
  id: variable
  parameters:
    comment: Muestras de cada turno de transmisión (múltiplo de sps)
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 108]
    rotation: 0
    state: enabled
- name: guarda
  id: variable
  parameters:
    comment: Muestras de silencio entre turnos
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [576, 108]
    rotation: 0
    state: enabled
- name: mensaje_A
  id: variable
  parameters:
    comment: Texto que transmite el nodo A
    value: '"Hola, soy el nodo A. Este mensaje viaja por el canal compartido en mi ranura de tiempo (TDD)."'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 188]
    rotation: 0
    state: enabled
- name: mensaje_B
  id: variable
  parameters:
    comment: Texto que transmite el nodo B
    value: '"Hola, soy el nodo B. Respondo en la otra ranura: nunca transmitimos los dos al mismo tiempo!!"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 268]
    rotation: 0
    state: enabled
- name: payload_A
  id: variable
  parameters:
    comment: ''
    value: list(mensaje_A.encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 188]
    rotation: 0
    state: enabled
- name: payload_B
  id: variable
  parameters:
    comment: ''
    value: list(mensaje_B.encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 268]
    rotation: 0
    state: enabled
- name: L_A
  id: variable
  parameters:
    comment: ''
    value: len(payload_A)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 188]
    rotation: 0
    state: enabled
- name: L_B
