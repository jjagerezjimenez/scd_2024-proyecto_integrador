options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: El mismo enlace half-duplex de halfduplex_4qam.grc, sin gráficos, para medir BER por línea de comandos
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: halfduplex_4qam_ber
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Medición de BER del enlace half-duplex 4-QAM (sin interfaz)
    window_size: (1800, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: imports
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math, cmath
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1120, 12]
    rotation: 0
    state: enabled
- name: ebn0_db
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Eb/N0 [dB]
    short_id: ''
    type: eng_float
    value: '6.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: fase_deg
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Fase del canal [grados]
    short_id: ''
    type: eng_float
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 12]
    rotation: 0
    state: enabled
- name: cfo_hz
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Desvio entre osciladores A-B [Hz]
    short_id: ''
    type: eng_float
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [456, 12]
    rotation: 0
    state: enabled
- name: costas_bw
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: BW del lazo de Costas (0 = sin corregir fase)
