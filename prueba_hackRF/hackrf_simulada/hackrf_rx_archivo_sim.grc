options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "VERSI\xD3N SIMULADA de grc_hackrf/hackrf_rx_archivo.grc (la genera\
      \ hackrf_simulada/generar_grc_simulados.py): en lugar de una HackRF usa emulador_hackrf.py.\
      \ Recibe con un HackRF los paquetes de hackrf_tx_archivo.grc (FLL, sincronismo,\
      \ Costas, CRC-32) y guarda los correctos en paquetes_recibidos.bin y datos_recibidos.bin;\
      \ solo bloques est\xE1ndar de GNU Radio"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hackrf_rx_archivo_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "[SIMULADA] HackRF RX: recepci\xF3n de un archivo (4-QAM, bloques est\xE1\
      ndar)"
    window_size: (1850, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: N
  id: variable
  parameters:
    comment: Bytes del archivo por paquete (igual que en el transmisor)
    value: '200'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 12]
    rotation: 0
    state: enabled
- name: ajustes_hackrf
  id: variable
  parameters:
    comment: "Lo que el bloque Soapy le pedir\xEDa a la placa (frecuencia, muestreo,\
      \ ganancias), como texto"
    value: ("equipo=rx frecuencia=%r muestreo=%r lna=%r vga=%r amp=%d" % (float(freq_mhz
      * 1e6 - f_offset), float(samp_rate), float(lna), float(vga_rx), bool(amp_rx))).encode()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 300]
    rotation: 0
    state: enabled
- name: amp_rx
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    'false': 'False'
    gui_hint: 0,1,1,1
    label: Amplificador RX (+11 dB)
    'true': 'True'
    type: bool
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 100]
    rotation: 0
    state: enabled
- name: ber_est
  id: variable
  parameters:
    comment: "BER te\xF3rico de 4-QAM diferencial para el Eb/N0 estimado"
    value: 2 * p_est * (1 - p_est)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 804]
    rotation: 0
    state: enabled
- name: cfo_hz
  id: variable
  parameters:
    comment: "Desv\xEDo de frecuencia de la se\xF1al recibida [Hz] (FLL + Costas;\
      \ corrigen con el signo opuesto)"
    value: -(w_fll * samp_rate_rx + w_costas * samp_rate_rx / sps) / (2 * math.pi)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1592, 724]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,1,1,1
    label: BW lazo de Costas
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.01'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 468]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: "Diezmado: despu\xE9s de filtrar quedan 1 M muestras/s"
    value: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 12]
    rotation: 0
    state: enabled
- name: dispositivo
  id: variable
  parameters:
    comment: "Para elegir un HackRF: \"serial=...\" (ver hackrf_info). Vac\xEDo =\
      \ el primero"
    value: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [984, 12]
    rotation: 0
    state: enabled
- name: eb_n0_db
  id: variable
  parameters:
    comment: "Eb/N0 = Es/N0 - 3 dB (2 bits por s\xEDmbolo)"
    value: es_n0_db - 10 * math.log10(2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1792, 724]
    rotation: 0
    state: enabled
- name: es_n0_db
  id: variable_function_probe
  parameters:
    block_id: estimador_snr
    comment: ''
    function_args: ''
    function_name: snr
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1592, 596]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: Factor de roll-off del filtro RRC
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 12]
    rotation: 0
    state: enabled
- name: f_offset
  id: variable
  parameters:
    comment: Desplazamiento digital [Hz] (igual que en el transmisor)
    value: 400e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [688, 12]
    rotation: 0
    state: enabled
- name: fll_bw
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,1
    label: BW lazo FLL
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.005'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 468]
    rotation: 0
    state: enabled
- name: freq_mhz
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: 0,0,1,1
    label: Frecuencia [MHz]
    type: real
    value: '915'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 100]
    rotation: 0
    state: enabled
- name: items_detectados
  id: variable_function_probe
  parameters:
    block_id: detector_trama
    comment: ''
    function_args: '0'
    function_name: nitems_written
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 596]
    rotation: 0
    state: enabled
- name: items_ok
  id: variable_function_probe
  parameters:
    block_id: crc
    comment: ''
    function_args: '0'
    function_name: nitems_written
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 596]
    rotation: 0
    state: enabled
- name: lbl_ber
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.1e'' % x if x == x else ''-'''
    gui_hint: 2,3,1,1
    label: "BER te\xF3rico (Eb/N0 est.): "
    type: real
    value: ber_est
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1744, 884]
    rotation: 0
    state: enabled
- name: lbl_cfo
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.0f Hz'' % x'
    gui_hint: 1,3,1,1
    label: "Desv\xEDo de frecuencia: "
    type: real
    value: cfo_hz
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1744, 468]
    rotation: 0
    state: enabled
- name: lbl_detectadas
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 0,4,1,1
    label: 'Tramas detectadas: '
    type: int
    value: tramas_detectadas
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1896, 100]
    rotation: 0
    state: enabled
- name: lbl_ebn0
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: "lambda x: '%.1f dB' % x if x == x else 'sin se\xF1al'"
    gui_hint: 2,2,1,1
    label: 'Eb/N0 estimado: '
    type: real
    value: eb_n0_db
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1592, 884]
    rotation: 0
    state: enabled
- name: lbl_mal
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 2,1,1,1
    label: 'Descartadas por CRC: '
    type: int
    value: max(tramas_detectadas - paquetes_ok, 0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 884]
    rotation: 0
    state: enabled
- name: lbl_ok
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 2,0,1,1
    label: 'Con CRC correcto: '
    type: int
    value: paquetes_ok
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 884]
    rotation: 0
    state: enabled
- name: lbl_per
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.1e'' % x if x == x else ''-'''
    gui_hint: 2,4,1,1
    label: "PER te\xF3rico (Eb/N0 est.): "
    type: real
    value: per_est
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1896, 884]
    rotation: 0
    state: enabled
- name: lbl_ppm
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.1f'' % x'
    gui_hint: 1,4,1,1
    label: "Desv\xEDo [ppm]: "
    type: real
    value: cfo_hz / freq_mhz
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1896, 468]
    rotation: 0
    state: enabled
- name: lna
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,2,1,1
    label: Ganancia LNA [dB]
    min_len: '120'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '8'
    stop: '40'
    value: '16'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1592, 100]
    rotation: 0
    state: enabled
- name: p_est
  id: variable
  parameters:
    comment: ''
    value: 0.5 * math.erfc(math.sqrt(10 ** (eb_n0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 804]
    rotation: 0
    state: enabled
- name: paquetes_ok
  id: variable
  parameters:
    comment: Paquetes con CRC correcto (2 + N bytes cada uno)
    value: int(items_ok) // (N + 2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 724]
    rotation: 0
    state: enabled
- name: per_est
  id: variable
  parameters:
    comment: "PER te\xF3rico: cada error del canal arruina 2 bits seguidos de la MISMA\
      \ trama -> depende de p, no del BER"
    value: 1 - (1 - p_est) ** (8 * (N + 18))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1592, 804]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 92]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Muestras por segundo del HackRF (igual que en el transmisor)
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: samp_rate_rx
  id: variable
  parameters:
    comment: ''
    value: samp_rate / decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "Muestras por s\xEDmbolo en el receptor (250 000 s\xEDmbolos/s, como\
      \ en el transmisor)"
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 12]
    rotation: 0
    state: enabled
- name: sync_bw
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,2,1,1
    label: "BW sinc. de s\xEDmbolo"
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.01'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1592, 468]
    rotation: 0
    state: enabled
- name: taps_canal
  id: variable
  parameters:
    comment: "Filtro pasabajos del canal: deja pasar la se\xF1al (\xB1170 kHz, +40\
      \ kHz de desv\xEDo) y elimina la portadora residual y lo dem\xE1s"
    value: firdes.low_pass(1, samp_rate, 300e3, 100e3)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1104, 12]
    rotation: 0
    state: enabled
- name: tramas_detectadas
  id: variable
  parameters:
    comment: "Tramas cuyo pre\xE1mbulo se encontr\xF3 (el detector entrega N + 6 bytes\
      \ en bits)"
    value: int(items_detectados) // (8 * (N + 6))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 724]
    rotation: 0
    state: enabled
- name: umbral
  id: variable
  parameters:
    comment: "Bits err\xF3neos tolerados al buscar el pre\xE1mbulo de 64 bits"
    value: '12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 12]
    rotation: 0
    state: enabled
- name: vga_rx
  id: variable_qtgui_range
  parameters:
