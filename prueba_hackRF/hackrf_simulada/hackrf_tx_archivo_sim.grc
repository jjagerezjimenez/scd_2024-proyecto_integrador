options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "VERSI\xD3N SIMULADA de grc_hackrf/hackrf_tx_archivo.grc (la genera\
      \ hackrf_simulada/generar_grc_simulados.py): en lugar de una HackRF usa emulador_hackrf.py.\
      \ Transmite un archivo en paquetes numerados (CRC-32, pre\xE1mbulo y longitud)\
      \ con 4-QAM diferencial por un HackRF; solo bloques est\xE1ndar de GNU Radio"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hackrf_tx_archivo_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "[SIMULADA] HackRF TX: transmisi\xF3n de un archivo (4-QAM, bloques est\xE1\
      ndar)"
    window_size: (1850, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: N
  id: variable
  parameters:
    comment: "Bytes del archivo por paquete (tiene que ser el mismo n\xFAmero en el\
      \ receptor)"
    value: '200'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 108]
    rotation: 0
    state: enabled
- name: W
  id: variable
  parameters:
    comment: 'Bytes de relleno al comienzo de cada pasada: dan tiempo a que el receptor
      se enganche'
    value: '2500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 108]
    rotation: 0
    state: enabled
- name: ajustes_hackrf
  id: variable
  parameters:
    comment: "Lo que el bloque Soapy le pedir\xEDa a la placa (frecuencia, muestreo,\
      \ ganancias), como texto"
    value: ("equipo=tx frecuencia=%r muestreo=%r vga=%r amp=%d" % (float(freq_mhz
      * 1e6 - f_offset), float(samp_rate), float(vga_tx), bool(amp_tx))).encode()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 1000]
    rotation: 0
    state: enabled
- name: amp_tx
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    'false': 'False'
    gui_hint: 0,2,1,1
    label: Amplificador TX (+14 dB)
    'true': 'True'
    type: bool
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1592, 100]
    rotation: 0
    state: enabled
- name: amplitud
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,3,1,1
    label: Amplitud digital (pico < 1)
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.05'
    step: '0.05'
    stop: '0.7'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1744, 100]
    rotation: 0
    state: enabled
- name: bytes_pasada
  id: variable
  parameters:
    comment: ''
    value: W + n_paq * bytes_trama
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 428]
    rotation: 0
    state: enabled
- name: bytes_trama
  id: variable
  parameters:
    comment: "pre\xE1mbulo 8 + longitud 4 + n\xFAmero 2 + datos N + CRC 4"
    value: N + 18
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 428]
    rotation: 0
    state: enabled
- name: contenido
  id: variable
  parameters:
    comment: "Bytes del archivo (si no se encuentra, se env\xEDa un aviso de texto)"
    value: list(open(archivo, "rb").read()) if encontrado else list(("No se encontro
      el archivo " + archivo).encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 188]
    rotation: 0
    state: enabled
- name: datos
  id: variable
  parameters:
    comment: 'Datos de una pasada: archivo completado con ceros hasta N bytes por
      paquete + paquete final'
    value: contenido + [0] * (n_datos * N - len(contenido)) + (descripcion + [0] *
      N)[:N]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 348]
    rotation: 0
    state: enabled
- name: descripcion
  id: variable
  parameters:
    comment: "\xDAltimo paquete de cada pasada: ARCHIVO|nombre (hasta 40 bytes)|tama\xF1\
      o|N|paquetes|huella|"
    value: list(b"ARCHIVO|" + nombre.encode()[:40] + ("|%d|%d|%d|%s|" % (len(contenido),
      N, n_paq, huella)).encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 268]
    rotation: 0
    state: enabled
- name: dispositivo
  id: variable
  parameters:
    comment: "Para elegir un HackRF: \"serial=...\" (ver hackrf_info). Vac\xEDo =\
      \ el primero"
    value: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 108]
    rotation: 0
    state: enabled
- name: duracion_pasada
  id: variable
  parameters:
    comment: "Segundos que dura una pasada (2 bits por s\xEDmbolo)"
    value: bytes_pasada * 8 / 2 / (samp_rate / sps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [680, 428]
    rotation: 0
    state: enabled
- name: encontrado
  id: variable
  parameters:
    comment: ''
    value: os.path.isfile(archivo)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 188]
    rotation: 0
    state: enabled
- name: enviados
  id: variable_function_probe
  parameters:
    block_id: limite
    comment: ''
    function_args: '0'
    function_name: nitems_written
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 228]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: "Factor de roll-off del filtro RRC (igual que en la simulaci\xF3n)"
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 108]
    rotation: 0
    state: enabled
- name: f_offset
  id: variable
  parameters:
    comment: "Desplazamiento digital [Hz]: el HackRF se sintoniza 400 kHz m\xE1s abajo\
      \ y la se\xF1al se corre +400 kHz, as\xED la portadora residual del oscilador\
      \ (pico en el centro del espectro) queda fuera de la se\xF1al"
    value: 400e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 108]
    rotation: 0
    state: enabled
- name: formato_trama
  id: variable_header_format_default
  parameters:
    access_code: '0'
    bps: '1'
    comment: ''
    threshold: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 268]
    rotation: 0
    state: enabled
- name: freq_mhz
  id: variable_qtgui_entry
  parameters:
    comment: ''
    entry_signal: editingFinished
    gui_hint: 0,0,1,1
    label: Frecuencia [MHz]
    type: real
    value: '915'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 100]
    rotation: 0
    state: enabled
- name: huella
  id: variable
  parameters:
    comment: "Huella SHA-256 del archivo: el receptor la usa para comprobar que lleg\xF3\
      \ id\xE9ntico"
    value: hashlib.sha256(bytes(contenido)).hexdigest()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 188]
    rotation: 0
    state: enabled
- name: lbl_archivo
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 1,0,1,1
    label: 'Archivo: '
    type: string
    value: '"%s (%d bytes)" % (nombre, len(contenido))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 228]
    rotation: 0
    state: enabled
- name: lbl_huella
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 1,2,1,1
    label: 'SHA-256: '
    type: string
    value: huella[:16] + "..."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1744, 228]
    rotation: 0
    state: enabled
- name: lbl_paquetes
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: None
    gui_hint: 1,1,1,1
    label: 'Paquetes por pasada: '
    type: string
    value: '"%d (%.2f s cada pasada)" % (n_paq, duracion_pasada)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1592, 228]
    rotation: 0
    state: enabled
- name: lbl_pasadas
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.2f'' % x'
    gui_hint: 1,3,1,1
    label: 'Pasadas enviadas: '
    type: real
    value: min(enviados, total_bytes - W) / bytes_pasada
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1896, 228]
    rotation: 0
    state: enabled
- name: n_datos
  id: variable
  parameters:
    comment: Paquetes con datos del archivo
    value: (len(contenido) + N - 1) // N
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 268]
    rotation: 0
    state: enabled
- name: n_paq
  id: variable
  parameters:
    comment: "Paquetes por pasada: los de datos + uno final con nombre, tama\xF1o\
      \ y huella"
    value: n_datos + 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 268]
    rotation: 0
    state: enabled
- name: nombre
  id: variable
  parameters:
    comment: ''
    value: os.path.basename(archivo) if encontrado else "ERROR_archivo_no_encontrado.txt"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 188]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 108]
    rotation: 0
    state: enabled
- name: relleno
  id: variable
  parameters:
    comment: "Bytes al azar (sin pre\xE1mbulo): no son tramas"
    value: list(random.Random(1).randbytes(W))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [880, 348]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: "Muestras por segundo del HackRF (2 M es el m\xEDnimo recomendado)"
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 108]
    rotation: 0
    state: enabled
- name: secuencia
  id: variable
  parameters:
    comment: "N\xFAmero de cada paquete (2 bytes): 0, 1, 2, ... n_paq-1"
    value: '[b for i in range(n_paq) for b in ((i // 256) % 256, i % 256)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 348]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "Muestras por s\xEDmbolo en el TX: 2 M / 8 = 250 000 s\xEDmbolos/s =\
      \ 500 kbit/s"
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 108]
    rotation: 0
    state: enabled
- name: total_bytes
  id: variable
  parameters:
    comment: "Bytes que se env\xEDan en total (+ un relleno final para que salga la\
      \ \xFAltima trama)"
    value: repeticiones * bytes_pasada + W if repeticiones > 0 else 2**62
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 428]
    rotation: 0
    state: enabled
- name: vga_tx
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,1,1,1
    label: Ganancia TX (VGA) [dB]
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '47'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 100]
    rotation: 0
    state: enabled
- name: ajuste_amplitud
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: amplitud
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 1300]
    rotation: 0
    state: enabled
- name: ajustes_periodicos
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: Repite los ajustes cada 200 ms (si cambian en la interfaz, cambia el
      mensaje)
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(len(ajustes_hackrf), list(ajustes_hackrf)))
    period: '200'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [904, 1000]
    rotation: 0
    state: enabled
- name: ajustes_red
  id: network_socket_pdu
  parameters:
    affinity: ''
    alias: ''
    comment: Manda los ajustes al emulador (UDP)
    host: 127.0.0.1
    maxoutbuf: '0'
    minoutbuf: '0'
    mtu: '10000'
    port: '5552'
    tcp_no_delay: 'False'
    type: UDP_CLIENT
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 1000]
    rotation: 0
    state: enabled
- name: archivo
  id: parameter
  parameters:
    alias: ''
    comment: ''
    hide: none
    label: Archivo a transmitir
    short_id: ''
    type: str
    value: ../grc_hackrf/archivo_a_enviar.txt
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: crc
  id: digital_crc32_bb
  parameters:
    affinity: ''
    alias: ''
    check: 'False'
    comment: ''
    lengthtagname: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packed: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 648]
    rotation: 0
    state: enabled
- name: datos_fuente
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: byte
    vector: datos
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 692]
    rotation: 0
    state: enabled
- name: datos_paquetes
  id: blocks_stream_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_len: N
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [192, 700]
    rotation: 0
    state: enabled
- name: desplazar
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: 2 * math.pi * f_offset / samp_rate
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 1300]
    rotation: 0
    state: enabled
- name: encabezado
  id: digital_protocol_formatter_bb
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    format: formato_trama
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 592]
    rotation: 0
    state: enabled
- name: g_cascada
  id: qtgui_waterfall_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    axislabels: 'True'
    bw: samp_rate
    color1: '0'
    color10: '0'
    color2: '0'
    color3: '0'
    color4: '0'
    color5: '0'
    color6: '0'
    color7: '0'
    color8: '0'
    color9: '0'
    comment: ''
    fc: '0'
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'False'
    gui_hint: 2,1,1,1
    int_max: '0'
    int_min: '-120'
    label1: ''
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Cascada (espectro en el tiempo)"'
    nconnections: '1'
    showports: 'False'
    type: complex
    update_time: '0.10'
    wintype: window.WIN_BLACKMAN_hARRIS
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [968, 1404]
    rotation: 0
    state: enabled
- name: g_espectro
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: ''
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 2,0,1,1
    label: '"Potencia relativa"'
    label1: TX
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Espectro que se transmite (centro = frecuencia - 400 kHz)"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '0'
    ymin: '-120'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 1404]
    rotation: 0
    state: enabled
- name: g_senal
  id: qtgui_time_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    axislabels: 'True'
    color1: blue
    color10: dark blue
    color2: red
    color3: green
    color4: black
    color5: cyan
    color6: magenta
    color7: yellow
    color8: dark red
    color9: dark green
    comment: ''
    ctrlpanel: 'False'
    entags: 'False'
    grid: 'True'
    gui_hint: 2,2,1,2
    label1: I
    label10: ''
    label2: Q
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    marker1: '-1'
    marker10: '-1'
    marker2: '-1'
    marker3: '-1'
    marker4: '-1'
    marker5: '-1'
    marker6: '-1'
    marker7: '-1'
