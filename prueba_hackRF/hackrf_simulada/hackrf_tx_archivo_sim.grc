- name: nota_paquetes
  id: note
  parameters:
    alias: ''
    comment: ''
    note: "PAQUETES: [n\xFAmero (2 bytes) | N bytes del archivo] -> CRC-32 -> pre\xE1\
      mbulo 64 b + longitud x2. El \xFAltimo paquete de cada pasada lleva nombre,\
      \ tama\xF1o y huella SHA-256 del archivo."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 516]
    rotation: 0
    state: enabled
- name: nota_pasada
  id: note
  parameters:
    alias: ''
    comment: ''
    note: "PASADA = [relleno W bytes | n_paq tramas]. Head corta despu\xE9s de 'repeticiones'\
      \ pasadas (y un relleno final)."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
