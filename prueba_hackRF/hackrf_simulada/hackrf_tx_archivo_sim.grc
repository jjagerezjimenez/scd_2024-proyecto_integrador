- name: nota_rf
  id: note
  parameters:
    alias: ''
    comment: ''
    note: "4-QAM diferencial + RRC (8 muestras/s\xEDmbolo) -> se corre +400 kHz ->\
      \ amplitud -> HackRF (sintonizado en la frecuencia elegida menos 400 kHz)"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1220]
    rotation: 0
    state: enabled
