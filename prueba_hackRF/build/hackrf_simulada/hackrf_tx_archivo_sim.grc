options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: |-
      Opciones del flowgraph: título de la ventana,
      interfaz QT GUI y nombre del programa que arma
      GRC al apretar F6 (hackrf_tx_archivo.py, en
      esta misma carpeta).
    copyright: ''
    description: 'VERSIÓN SIMULADA de grc_hackrf/hackrf_tx_archivo.grc (la genera hackrf_simulada/generar_grc_simulados.py): en lugar de una HackRF usa emulador_hackrf.py. Transmite un archivo en paquetes numerados (CRC-32, preámbulo y longitud) con 4-QAM diferencial por un HackRF; solo bloques estándar de GNU Radio'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hackrf_tx_archivo_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: '[SIMULADA] HackRF TX: transmisión de un archivo (4-QAM, bloques estándar)'
    window_size: (1850, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 336.0]
    rotation: 0
    state: enabled
blocks:
- name: N
  id: variable
  parameters:
    comment: |-
      Bytes del archivo en cada paquete. Tiene que
      ser el mismo número en el receptor.
    value: '200'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 568.0]
    rotation: 0
    state: enabled
- name: W
  id: variable
  parameters:
    comment: |-
      Bytes de relleno al azar al comienzo de cada
      pasada (2500 bytes = 40 ms): le dan tiempo al
      receptor para engancharse.
    value: '2500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 568.0]
    rotation: 0
    state: enabled
- name: amp_tx
  id: variable_qtgui_check_box
  parameters:
    comment: |-
      Casilla de la ventana: prende el amplificador
      extra del TX (+14 dB). Empezar con la casilla
      apagada; nunca prenderla con un cable sin
      atenuador.
    'false': 'False'
    gui_hint: 0,2,1,1
    label: Amplificador TX (+14 dB)
    'true': 'True'
    type: bool
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 1304.0]
    rotation: 0
    state: enabled
- name: amplitud
  id: variable_qtgui_range
  parameters:
    comment: |-
      Control de la ventana: número por el que se
      multiplica la señal antes de la HackRF. Los
      picos de I y Q tienen que quedar debajo de 1:
      usar 0,6 como máximo.
    gui_hint: 0,3,1,1
    label: Amplitud digital (pico < 1)
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.05'
    step: '0.05'
    stop: '0.7'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 1296.0]
    rotation: 0
    state: enabled
- name: bytes_pasada
  id: variable
  parameters:
    comment: 'Bytes de una pasada: relleno W + n_paq tramas.'
    value: W + n_paq * bytes_trama
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1104.0]
    rotation: 0
    state: enabled
- name: bytes_trama
  id: variable
  parameters:
    comment: |-
      Bytes de cada trama: preámbulo 8 + longitud 4
      + número 2 + datos N + CRC 4 = N + 18.
    value: N + 18
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 936.0]
    rotation: 0
    state: enabled
- name: contenido
  id: variable
  parameters:
    comment: |-
      Bytes del archivo, como lista de números de 0
      a 255 (se lee entero al abrir el flowgraph).
      Si no existe: el texto "No se encontro el
      archivo ...".
    value: list(open(archivo, "rb").read()) if encontrado else list(("No se encontro el archivo " + archivo).encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 752.0]
    rotation: 0
    state: enabled
- name: datos
  id: variable
  parameters:
    comment: |-
      Datos de una pasada: el archivo (completado
      con ceros hasta llenar el último paquete) + el
      paquete de descripción. Son n_paq × N bytes.
    value: contenido + [0] * (n_datos * N - len(contenido)) + (descripcion + [0] * N)[:N]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 936.0]
    rotation: 0
    state: enabled
- name: descripcion
  id: variable
  parameters:
    comment: |-
      Contenido del último paquete de cada pasada:
      ARCHIVO|nombre (hasta 40
      bytes)|tamaño|N|paquetes|huella|. Con él,
      reconstruir_archivo.py sabe cómo armar el
      archivo.
    value: list(b"ARCHIVO|" + nombre.encode()[:40] + ("|%d|%d|%d|%s|" % (len(contenido), N, n_paq, huella)).encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 936.0]
    rotation: 0
    state: enabled
- name: dispositivo
  id: variable
  parameters:
    comment: |-
      Qué HackRF usar: "serial=..." (el número lo
      muestra hackrf_info). Vacío = la primera que
      encuentre.
    value: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 360.0]
    rotation: 0
    state: enabled
- name: duracion_pasada
  id: variable
  parameters:
    comment: |-
      Segundos que dura una pasada en el aire (8
      bits por byte, 2 bits por símbolo, 250 000
      símbolos/s).
    value: bytes_pasada * 8 / 2 / (samp_rate / sps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 1104.0]
    rotation: 0
    state: enabled
- name: encontrado
  id: variable
  parameters:
    comment: |-
      True si el archivo existe. Si no existe, en su
      lugar se manda un texto de aviso.
    value: os.path.isfile(archivo)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 752.0]
    rotation: 0
    state: enabled
- name: enviados
  id: variable_function_probe
  parameters:
    block_id: limite
    comment: |-
      Lee 2 veces por segundo cuántos bytes ya
      salieron del bloque "limite" (Head), con su
      función nitems_written. Con eso se cuentan las
      pasadas.
    function_args: '0'
    function_name: nitems_written
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1512.0]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: |-
      Roll-off del filtro RRC (0,35): cuánto más
      ancho que el mínimo es el espectro. La señal
      ocupa 250 k × 1,35 ≈ 340 kHz.
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 568.0]
    rotation: 0
    state: enabled
- name: f_offset
  id: variable
  parameters:
    comment: |-
      Corrimiento digital de 400 kHz: la HackRF se
      sintoniza 400 kHz más abajo y la señal se
      corre +400 kHz. Así el pico que deja la placa
      en el centro del espectro queda fuera de la
      señal.
    value: 400e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 568.0]
    rotation: 0
    state: enabled
- name: formato_trama
  id: variable_header_format_default
  parameters:
    access_code: '0'
    bps: '1'
    comment: |-
      Formato del encabezado de cada trama:
      preámbulo de 64 bits (Access Code 0 = el
      preámbulo estándar de GNU Radio) + longitud
      del paquete en 16 bits, escrita 2 veces. Lo
      usa el Protocol Formatter.
    threshold: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 736.0]
    rotation: 0
    state: enabled
- name: freq_mhz
  id: variable_qtgui_entry
  parameters:
    comment: |-
      Casilla de la ventana: frecuencia de la
      portadora en MHz. Se aplica al apretar Enter.
      La HackRF se sintoniza en esta frecuencia -
      400 kHz (ver f_offset).
    entry_signal: editingFinished
    gui_hint: 0,0,1,1
    label: Frecuencia [MHz]
    type: real
    value: '915'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1320.0]
    rotation: 0
    state: enabled
- name: huella
  id: variable
  parameters:
    comment: |-
      Huella SHA-256 del archivo (64 caracteres): el
      receptor la usa para comprobar que el archivo
      llegó idéntico.
    value: hashlib.sha256(bytes(contenido)).hexdigest()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 752.0]
    rotation: 0
    state: enabled
- name: lbl_archivo
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana el nombre y el tamaño
      del archivo que se transmite.
    formatter: None
    gui_hint: 1,0,1,1
    label: 'Archivo: '
    type: string
    value: '"%s (%d bytes)" % (nombre, len(contenido))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 1520.0]
    rotation: 0
    state: enabled
- name: lbl_huella
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana el comienzo de la huella
      SHA-256 del archivo.
    formatter: None
    gui_hint: 1,2,1,1
    label: 'SHA-256: '
    type: string
    value: huella[:16] + "..."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 1520.0]
    rotation: 0
    state: enabled
- name: lbl_paquetes
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana cuántos paquetes tiene
      cada pasada y cuántos segundos dura.
    formatter: None
    gui_hint: 1,1,1,1
    label: 'Paquetes por pasada: '
    type: string
    value: '"%d (%.2f s cada pasada)" % (n_paq, duracion_pasada)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 1520.0]
    rotation: 0
    state: enabled
- name: lbl_pasadas
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana cuántas pasadas ya se
      mandaron (bytes que salieron / bytes por
      pasada). Va unos 0,5 s adelantado: hay
      muestras esperando en los buffers.
    formatter: 'lambda x: ''%.2f'' % x'
    gui_hint: 1,3,1,1
    label: 'Pasadas enviadas: '
    type: real
    value: min(enviados, total_bytes - W) / bytes_pasada
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1056, 1520.0]
    rotation: 0
    state: enabled
- name: n_datos
  id: variable
  parameters:
    comment: |-
      Cuántos paquetes de N bytes hacen falta para
      el archivo (redondeando hacia arriba).
    value: (len(contenido) + N - 1) // N
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 752.0]
    rotation: 0
    state: enabled
- name: n_paq
  id: variable
  parameters:
    comment: |-
      Paquetes por pasada: los de datos + 1 final
      que describe el archivo (nombre, tamaño y
      huella).
    value: n_datos + 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 936.0]
    rotation: 0
    state: enabled
- name: nombre
  id: variable
  parameters:
    comment: |-
      Nombre del archivo sin la carpeta (viaja en el
      último paquete). Si no existe:
      ERROR_archivo_no_encontrado.txt
    value: os.path.basename(archivo) if encontrado else "ERROR_archivo_no_encontrado.txt"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 752.0]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: |-
      Constelación 4-QAM: 4 puntos (±0,707 ± j0,707)
      con código Gray (Symbol Map 0, 1, 3, 2: los
      vecinos difieren en un solo bit). La usa el
      modulador.
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 312.0]
    rotation: 0
    state: enabled
- name: relleno
  id: variable
  parameters:
    comment: |-
      W bytes al azar (siempre los mismos: semilla
      1). No llevan preámbulo, así que el receptor
      no los toma como tramas.
    value: list(random.Random(1).randbytes(W))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 936.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: |-
      Muestreo: 2 M muestras por segundo (2 MHz de
      banda). Lo usan la HackRF, el Rotator y los
      gráficos. 2 M es lo mínimo recomendado para la
      HackRF.
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 568.0]
    rotation: 0
    state: enabled
- name: secuencia
  id: variable
  parameters:
    comment: |-
      Números de paquete de una pasada: 0, 1, 2, ...
      n_paq - 1, cada uno en 2 bytes (primero el
      byte alto).
    value: '[b for i in range(n_paq) for b in ((i // 256) % 256, i % 256)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 936.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: |-
      Muestras por símbolo en el TX. 2 M / 8 = 250
      000 símbolos/s; con 2 bits por símbolo son 500
      kbit/s.
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 568.0]
    rotation: 0
    state: enabled
- name: total_bytes
  id: variable
  parameters:
    comment: |-
      Bytes que deja pasar el Head: "repeticiones"
      pasadas + un relleno final (para que la última
      trama salga entera). Con repeticiones = 0 no
      hay límite (2^62).
    value: repeticiones * bytes_pasada + W if repeticiones > 0 else 2**62
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 1104.0]
    rotation: 0
    state: enabled
- name: vga_tx
  id: variable_qtgui_range
  parameters:
    comment: |-
      Control de la ventana: ganancia del
      amplificador variable (VGA) del TX de la
      HackRF, de 0 a 47 dB. Se puede cambiar
      mientras transmite.
    gui_hint: 0,1,1,1
    label: Ganancia TX (VGA) [dB]
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '47'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 1296.0]
    rotation: 0
    state: enabled
- name: ajuste_amplitud
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: |-
      Multiplica la señal por la
      "amplitud" de la ventana,
      para que los picos de I y
      Q no pasen de ±1 (si
      pasan, el DAC de la HackRF
      recorta).
      Entra: complejos.
      Sale: complejos escalados
        (van a la HackRF y a los
        gráficos).
    const: amplitud
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1424, 2600.0]
    rotation: 0
    state: enabled
- name: archivo
  id: parameter
  parameters:
    alias: ''
    comment: |-
      Parámetro: archivo que se transmite (ruta
      desde la carpeta de este .grc, con barras /).
      También se puede elegir al correr el .py:
      --archivo foto.jpg
    hide: none
    label: Archivo a transmitir
    short_id: ''
    type: str
    value: ../grc_hackrf/archivo_a_enviar.txt
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 344.0]
    rotation: 0
    state: enabled
- name: crc
  id: digital_crc32_bb
  parameters:
    affinity: ''
    alias: ''
    check: 'False'
    comment: |-
      Calcula el CRC-32 de cada paquete y se lo
      agrega al final (4 bytes). El receptor lo
      vuelve a calcular para descartar los paquetes
      con errores.
      Entra: bytes: paquete de N + 2 bytes
        (packet_len).
      Sale: bytes: paquete + CRC = N + 6 bytes
        (packet_len).
    lengthtagname: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packed: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 1960.0]
    rotation: 0
    state: enabled
- name: datos_fuente
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: |-
      Entrega una y otra vez la lista "datos": el
      archivo + el paquete de descripción.
      Entra: nada (es una fuente).
      Sale: bytes del archivo.
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: byte
    vector: datos
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 2200.0]
    rotation: 0
    state: enabled
- name: datos_paquetes
  id: blocks_stream_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: |-
      Corta los datos en grupos de N = 200 bytes
      (uno por paquete) marcados con packet_len =
      200.
      Entra: bytes sin marcas.
      Sale: los mismos bytes, en grupos de N
        marcados con packet_len.
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_len: N
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 2208.0]
    rotation: 0
    state: enabled
- name: desplazar
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: |-
      Corre la señal +400 kHz en frecuencia (la
      multiplica por una exponencial compleja). Así
      queda lejos del pico que deja la HackRF en el
      centro.
      Entra: complejos a 2 M muestras/s, centrados
        en 0 Hz.
      Sale: complejos a 2 M muestras/s, centrados en
        +400 kHz.
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: 2 * math.pi * f_offset / samp_rate
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 2592.0]
    rotation: 0
    state: enabled
- name: encabezado
  id: digital_protocol_formatter_bb
  parameters:
    affinity: ''
    alias: ''
    comment: |-
      Arma el encabezado de cada paquete
      con el formato "formato_trama":
      preámbulo de 64 bits + longitud (2
      veces). Solo produce el
      encabezado, no copia el paquete.
      Entra: bytes: paquete con CRC
        (packet_len).
      Sale: bytes: encabezado de 12
        bytes (packet_len = 12).
    format: formato_trama
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1128, 1736.0]
    rotation: 0
    state: enabled
- name: g_cascada
  id: qtgui_waterfall_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    axislabels: 'True'
    bw: samp_rate
    color1: '0'
    color10: '0'
    color2: '0'
    color3: '0'
    color4: '0'
    color5: '0'
    color6: '0'
    color7: '0'
    color8: '0'
    color9: '0'
    comment: |-
      Gráfico de cascada: el espectro a lo largo del
      tiempo (cada línea es un instante; el color,
      la potencia).
      Entra: complejos a 2 M muestras/s.
      Sale: nada (solo dibuja).
    fc: '0'
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'False'
    gui_hint: 2,1,1,1
    int_max: '0'
    int_min: '-120'
    label1: ''
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Cascada (espectro en el tiempo)"'
    nconnections: '1'
