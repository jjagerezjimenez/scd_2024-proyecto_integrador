      (gira la señal al revés).
      Entra: complejos a 1 M
        muestras/s.
      Sale: out0 = señal corregida
        (complejos); out1 = frecuencia
        corregida, out2 = fase, out3 =
        error (reales).
    filter_size: '44'
    maxoutbuf: '0'
    minoutbuf: '0'
    rolloff: excess_bw
    samps_per_sym: sps
    type: cc
    w: fll_bw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1936, 2848.0]
    rotation: 0
    state: enabled
