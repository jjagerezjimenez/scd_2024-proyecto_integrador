options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: |-
      Opciones del flowgraph: título de la ventana,
      interfaz QT GUI y nombre del programa que arma
      GRC al apretar F6 (hackrf_rx_archivo.py, en
      esta misma carpeta).
    copyright: ''
    description: 'VERSIÓN SIMULADA de grc_hackrf/hackrf_rx_archivo.grc (la genera hackrf_simulada/generar_grc_simulados.py): en lugar de una HackRF usa emulador_hackrf.py. Recibe con un HackRF los paquetes de hackrf_tx_archivo.grc (FLL, sincronismo, Costas, CRC-32) y guarda los correctos en paquetes_recibidos.bin y datos_recibidos.bin; solo bloques estándar de GNU Radio'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hackrf_rx_archivo_sim
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: '[SIMULADA] HackRF RX: recepción de un archivo (4-QAM, bloques estándar)'
    window_size: (1850, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 336.0]
    rotation: 0
    state: enabled
blocks:
- name: N
  id: variable
  parameters:
    comment: |-
      Bytes del archivo en cada paquete. Tiene que
      ser el mismo número que en el transmisor.
    value: '200'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 696.0]
    rotation: 0
    state: enabled
- name: amp_rx
  id: variable_qtgui_check_box
  parameters:
    comment: |-
      Casilla de la ventana: prende el amplificador
      extra del RX (+11 dB). Empezar con la casilla
      apagada.
    'false': 'False'
    gui_hint: 0,1,1,1
    label: Amplificador RX (+11 dB)
    'true': 'True'
    type: bool
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1672, 320.0]
    rotation: 0
    state: enabled
- name: ber_est
  id: variable
  parameters:
    comment: |-
      BER teórico de 4-QAM con codificación
      diferencial: 2 p (1 - p) (cada error del canal
      arruina 2 bits).
    value: 2 * p_est * (1 - p_est)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 1392.0]
    rotation: 0
    state: enabled
- name: cfo_hz
  id: variable
  parameters:
    comment: |-
      Desvío de frecuencia de la señal recibida, en
      Hz: suma lo que corrigen el FLL y Costas (los
      dos corrigen con el signo opuesto al desvío).
    value: -(w_fll * samp_rate_rx + w_costas * samp_rate_rx / sps) / (2 * math.pi)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 1256.0]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable_qtgui_range
  parameters:
    comment: |-
      Control de la ventana: ancho de banda del lazo
      de Costas (corrige la fase que le queda a la
      señal).
    gui_hint: 1,1,1,1
    label: BW lazo de Costas
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.01'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1672, 528.0]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: |-
      Diezmado: después de filtrar el canal se queda
      1 de cada 2 muestras (2 M -> 1 M muestras/s).
    value: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 552.0]
    rotation: 0
    state: enabled
- name: dispositivo
  id: variable
  parameters:
    comment: |-
      Qué HackRF usar: "serial=..." (el número lo
      muestra hackrf_info). Vacío = la primera que
      encuentre.
    value: '"0000000000000000176c63c82a893d23"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 360.0]
    rotation: 0
    state: enabled
- name: eb_n0_db
  id: variable
  parameters:
    comment: |-
      Eb/N0 = Es/N0 - 3 dB (cada símbolo lleva 2
      bits).
    value: es_n0_db - 10 * math.log10(2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 1256.0]
    rotation: 0
    state: enabled
- name: es_n0_db
  id: variable_function_probe
  parameters:
    block_id: estimador_snr
    comment: |-
      Lee 2 veces por segundo el Es/N0 (en dB) que
      calcula el bloque "estimador_snr".
    function_args: ''
    function_name: snr
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 1080.0]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: |-
      Roll-off del filtro RRC (0,35), igual que en
      el transmisor. Lo usan el FLL y el filtro
      adaptado.
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1112, 552.0]
    rotation: 0
    state: enabled
- name: f_offset
  id: variable
  parameters:
    comment: |-
      Corrimiento digital de 400 kHz (igual que en
      el transmisor): la HackRF se sintoniza 400 kHz
      más abajo, así que la señal llega en +400 kHz.
    value: 400e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 696.0]
    rotation: 0
    state: enabled
- name: fll_bw
  id: variable_qtgui_range
  parameters:
    comment: |-
      Control de la ventana: ancho de banda del lazo
      del FLL. Más grande = engancha más rápido pero
      con más ruido.
    gui_hint: 1,0,1,1
    label: BW lazo FLL
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.005'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 528.0]
    rotation: 0
    state: enabled
- name: freq_mhz
  id: variable_qtgui_entry
  parameters:
    comment: |-
      Casilla de la ventana: frecuencia de la
      portadora en MHz (la misma que en el
      transmisor). Se aplica al apretar Enter.
    entry_signal: editingFinished
    gui_hint: 0,0,1,1
    label: Frecuencia [MHz]
    type: real
    value: '915'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 336.0]
    rotation: 0
    state: enabled
- name: items_detectados
  id: variable_function_probe
  parameters:
    block_id: detector_trama
    comment: |-
      Lee 2 veces por segundo cuántos bits entregó
      el detector de tramas (nitems_written del
      bloque "detector_trama").
    function_args: '0'
    function_name: nitems_written
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 1080.0]
    rotation: 0
    state: enabled
- name: items_ok
  id: variable_function_probe
  parameters:
    block_id: crc
    comment: |-
      Lee 2 veces por segundo cuántos bytes ya
      salieron del CRC (función nitems_written del
      bloque "crc").
    function_args: '0'
    function_name: nitems_written
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1080.0]
    rotation: 0
    state: enabled
- name: lbl_ber
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana el BER que da la teoría
      para ese Eb/N0.
    formatter: 'lambda x: ''%.1e'' % x if x == x else ''-'''
    gui_hint: 2,3,1,1
    label: 'BER teórico (Eb/N0 est.): '
    type: real
    value: ber_est
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2472, 728.0]
    rotation: 0
    state: enabled
- name: lbl_cfo
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana el desvío de frecuencia
      de la señal recibida, en Hz.
    formatter: 'lambda x: ''%.0f Hz'' % x'
    gui_hint: 1,3,1,1
    label: 'Desvío de frecuencia: '
    type: real
    value: cfo_hz
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1672, 728.0]
    rotation: 0
    state: enabled
- name: lbl_detectadas
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana cuántas tramas se
      detectaron (preámbulo encontrado), estén bien
      o mal.
    formatter: None
    gui_hint: 0,4,1,1
    label: 'Tramas detectadas: '
    type: int
    value: tramas_detectadas
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2200, 552.0]
    rotation: 0
    state: enabled
- name: lbl_ebn0
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana el Eb/N0 que se estima
      con los símbolos recibidos.
    formatter: 'lambda x: ''%.1f dB'' % x if x == x else ''sin señal'''
    gui_hint: 2,2,1,1
    label: 'Eb/N0 estimado: '
    type: real
    value: eb_n0_db
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2200, 728.0]
    rotation: 0
    state: enabled
- name: lbl_mal
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana cuántas tramas se
      detectaron pero el CRC descartó.
    formatter: None
    gui_hint: 2,1,1,1
    label: 'Descartadas por CRC: '
    type: int
    value: max(tramas_detectadas - paquetes_ok, 0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 728.0]
    rotation: 0
    state: enabled
- name: lbl_ok
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana cuántos paquetes pasaron
      el CRC (llegaron sin errores).
    formatter: None
    gui_hint: 2,0,1,1
    label: 'Con CRC correcto: '
    type: int
    value: paquetes_ok
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2472, 552.0]
    rotation: 0
    state: enabled
- name: lbl_per
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana el PER (fracción de
      paquetes perdidos) que da la teoría para ese
      Eb/N0.
    formatter: 'lambda x: ''%.1e'' % x if x == x else ''-'''
    gui_hint: 2,4,1,1
    label: 'PER teórico (Eb/N0 est.): '
    type: real
    value: per_est
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 888.0]
    rotation: 0
    state: enabled
- name: lbl_ppm
  id: variable_qtgui_label
  parameters:
    comment: |-
      Muestra en la ventana el mismo desvío en ppm
      (Hz por cada MHz de portadora): cuánto
      difieren los relojes de las dos HackRF.
    formatter: 'lambda x: ''%.1f'' % x'
    gui_hint: 1,4,1,1
    label: 'Desvío [ppm]: '
    type: real
    value: cfo_hz / freq_mhz
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1936, 728.0]
    rotation: 0
    state: enabled
- name: lna
  id: variable_qtgui_range
  parameters:
    comment: |-
      Control de la ventana: ganancia del LNA
      (primer amplificador del RX), de 0 a 40 dB en
      pasos de 8.
    gui_hint: 0,2,1,1
    label: Ganancia LNA [dB]
    min_len: '120'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '8'
    stop: '40'
    value: '16'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1936, 312.0]
    rotation: 0
    state: enabled
- name: p_est
  id: variable
  parameters:
    comment: |-
      Probabilidad de que un símbolo se decida mal
      en un eje: p = Q(raíz(2 Eb/N0)).
    value: 0.5 * math.erfc(math.sqrt(10 ** (eb_n0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1392.0]
    rotation: 0
    state: enabled
- name: paquetes_ok
  id: variable
  parameters:
    comment: |-
      Paquetes con CRC correcto = bytes que salieron
      del CRC / (N + 2).
    value: int(items_ok) // (N + 2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1256.0]
    rotation: 0
    state: enabled
- name: per_est
  id: variable
  parameters:
    comment: |-
      PER teórico: probabilidad de que una trama de
      8 × (N + 18) bits tenga algún error = 1 - (1 -
      p)^bits.
    value: 1 - (1 - p_est) ** (8 * (N + 18))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 1392.0]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: |-
      Constelación 4-QAM: 4 puntos (±0,707 ± j0,707)
      con código Gray (Symbol Map 0, 1, 3, 2), la
      misma del transmisor. La usa el decisor.
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 312.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: |-
      Muestreo de la HackRF: 2 M muestras por
      segundo (igual que en el transmisor).
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 552.0]
    rotation: 0
    state: enabled
- name: samp_rate_rx
  id: variable
  parameters:
    comment: |-
      Muestreo después del diezmado: 1 M muestras/s.
      Lo usan los bloques del receptor.
    value: samp_rate / decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 552.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: |-
      Muestras por símbolo en el receptor: 4 (1 M /
      4 = 250 000 símbolos/s, como en el
      transmisor).
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 552.0]
    rotation: 0
    state: enabled
- name: sync_bw
  id: variable_qtgui_range
  parameters:
    comment: |-
      Control de la ventana: ancho de banda del lazo
      del sincronismo de símbolo.
    gui_hint: 1,2,1,1
    label: BW sinc. de símbolo
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.01'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1936, 528.0]
    rotation: 0
    state: enabled
- name: taps_canal
  id: variable
  parameters:
    comment: |-
      Coeficientes del filtro pasabajos del canal:
      corte en 300 kHz y transición de 100 kHz. Deja
      pasar la señal (±170 kHz, con hasta 40 kHz de
      desvío) y quita el pico del centro y lo demás.
    value: firdes.low_pass(1, samp_rate, 300e3, 100e3)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1112, 360.0]
    rotation: 0
    state: enabled
- name: tramas_detectadas
  id: variable
  parameters:
    comment: |-
      Tramas detectadas = bits que entregó el
      detector / bits de cada trama (8 × (N + 6)).
    value: int(items_detectados) // (8 * (N + 6))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 1256.0]
    rotation: 0
    state: enabled
- name: umbral
  id: variable
  parameters:
    comment: |-
      Cuántos bits del preámbulo (de 64) pueden
      llegar mal y aun así se acepta la trama.
    value: '12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 696.0]
    rotation: 0
    state: enabled
- name: vga_rx
  id: variable_qtgui_range
  parameters:
    comment: |-
      Control de la ventana: ganancia del VGA
      (amplificador variable del RX), de 0 a 62 dB
      en pasos de 2.
    gui_hint: 0,3,1,1
    label: Ganancia VGA [dB]
    min_len: '120'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '2'
    stop: '62'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2200, 312.0]
    rotation: 0
    state: enabled
- name: w_costas
  id: variable_function_probe
  parameters:
    block_id: costas_sonda
    comment: |-
      Lee 2 veces por segundo la corrección promedio
      de Costas (bloque "costas_sonda"), en radianes
      por símbolo.
    function_args: ''
    function_name: level
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 1080.0]
    rotation: 0
    state: enabled
- name: w_fll
  id: variable_function_probe
  parameters:
    block_id: fll_sonda
    comment: |-
      Lee 2 veces por segundo la corrección promedio
      del FLL (bloque "fll_sonda"), en radianes por
      muestra.
    function_args: ''
    function_name: level
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 1080.0]
    rotation: 0
    state: enabled
- name: a_bits
  id: blocks_unpack_k_bits_bb
  parameters:
    affinity: ''
    alias: ''
    comment: |-
      Separa cada número en sus 2 bits (primero el
      más significativo).
      Entra: bytes con 2 bits útiles (0 a 3), 250
        k/s.
      Sale: bits sueltos (1 bit por byte: 0 o 1),
        500 k/s.
    k: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3872, 2888.0]
    rotation: 0
    state: enabled
- name: a_bytes
  id: blocks_repack_bits_bb
  parameters:
    affinity: ''
    alias: ''
    align_output: 'True'
    comment: |-
      Junta los bits de a 8 para volver a formar
      bytes, respetando dónde empieza cada paquete
      (packet_len).
      Entra: bits sueltos (1 por byte).
      Sale: bytes: N + 6 por paquete (packet_len).
    endianness: gr.GR_MSB_FIRST
    k: '1'
    l: '8'
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '70000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 3416.0]
    rotation: 0
    state: enabled
- name: acelerador
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: |-
      (Deshabilitado) Frena la lectura de la
      grabación a 2 M muestras/s, la velocidad real
      de la HackRF.
      Entra: complejos.
      Sale: los mismos complejos, a 2 M muestras/s.
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 2616.0]
    rotation: 0
    state: disabled
- name: agc
  id: analog_agc2_xx
  parameters:
    affinity: ''
    alias: ''
    attack_rate: 1e-2
    comment: |-
      Control automático de
      ganancia: sube o baja la
      ganancia para que la señal
      tenga nivel 1, llegue fuerte
      o débil.
      Entra: complejos a 1 M
        muestras/s.
      Sale: complejos a 1 M
        muestras/s, con nivel 1.
    decay_rate: 1e-3
    gain: '1.0'
    max_gain: '65536'
    maxoutbuf: '0'
    minoutbuf: '0'
    reference: '1.0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1680, 2856.0]
    rotation: 0
    state: enabled
- name: alto_f
  id: blocks_uchar_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: |-
      Pasa el byte alto (0 a 255) a número real,
      para hacer cuentas.
      Entra: bytes.
      Sale: reales.
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2216, 3888.0]
    rotation: 0
    state: enabled
- name: archivo_datos
