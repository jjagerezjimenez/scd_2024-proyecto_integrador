      Entra: complejos, 1 por símbolo.
      Sale: mensajes (no se usan).
    maxoutbuf: '0'
    minoutbuf: '0'
    msg_nsamples: '10000'
    type: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3040, 2376.0]
    rotation: 0
    state: enabled
