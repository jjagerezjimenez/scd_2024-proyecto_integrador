    comment: |-
      Guarda solo los datos de los paquetes
      correctos en datos_recibidos.bin, en el orden
      en que llegaron.
      Entra: bytes de datos.
      Sale: nada (escribe el archivo).
    file: '"datos_recibidos.bin"'
    type: byte
    unbuffered: 'True'
    vlen: '1'
