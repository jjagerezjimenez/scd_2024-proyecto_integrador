  id: note
  parameters:
    alias: ''
    comment: "TRANSMISORES\ncada nodo arma sus tramas (mensaje -> CRC-32\n-> pre\xE1\
      mbulo de 64 bits + longitud \xD72) y las\nmodula en 4-QAM diferencial con filtro\
      \ RRC."
    note: "TRANSMISORES: cada nodo arma sus tramas (mensaje -> CRC-32 -> pre\xE1mbulo\
      \ 64 b + longitud x2) y las modula en 4-QAM diferencial con filtro RRC"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 616.0]
    rotation: 0
    state: enabled
