    bus_source: false
    bus_structure: null
    coordinate: [1552, 152.0]
    rotation: 0
    state: enabled
- name: umbral
  id: variable
  parameters:
    comment: "Bits err\xF3neos tolerados al buscar el pre\xE1mbulo de 64 bits"
