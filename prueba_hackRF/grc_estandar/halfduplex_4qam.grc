options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: "Opciones del flowgraph: t\xEDtulo de la ventana,\ninterfaz QT GUI y\
      \ nombre del programa que arma\nGRC al apretar F6 (halfduplex_4qam.py, en esta\n\
      misma carpeta)."
    copyright: ''
    description: "Dos nodos que se turnan un canal compartido (TDD) con tramas (pre\xE1\
      mbulo + longitud + CRC-32), 4-QAM diferencial y medici\xF3n de BER; solo bloques\
      \ est\xE1ndar de GNU Radio"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: halfduplex_4qam
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Enlace half-duplex 4-QAM (TDD) con tramas y BER (bloques est\xE1ndar)"
    window_size: (1800, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 32.0]
    rotation: 0
    state: enabled

blocks:
- name: L_A
  id: variable
  parameters:
    comment: 'Bytes de payload de cada trama del nodo A

      (largo de su mensaje).'
    value: len(payload_A)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1336, 264.0]
    rotation: 0
    state: enabled
- name: L_B
  id: variable
  parameters:
    comment: Bytes de payload de cada trama del nodo B.
    value: len(payload_B)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1336, 400.0]
    rotation: 0
    state: enabled
- name: ber_A_log
  id: variable_function_probe
  parameters:
    block_id: rxA_sonda_ber
    comment: 'Lee 4 veces por segundo el log10 del BER

      acumulado del nodo A (bloque "rxA_sonda_ber").'
    function_args: ''
    function_name: level
    poll_rate: '4'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2144, 240.0]
    rotation: 0
    state: enabled
- name: ber_B_log
  id: variable_function_probe
  parameters:
    block_id: rxB_sonda_ber
    comment: 'Lee 4 veces por segundo el log10 del BER

      acumulado del nodo B (bloque "rxB_sonda_ber").'
    function_args: ''
    function_name: level
    poll_rate: '4'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2680, 240.0]
    rotation: 0
    state: enabled
- name: ber_teo
  id: variable
  parameters:
    comment: "BER te\xF3rico de 4-QAM con codificaci\xF3n\ndiferencial: 2 p (1 - p).\
      \ Un bit sale mal si\nexactamente uno de los dos s\xEDmbolos que se\ncomparan\
      \ se decidi\xF3 mal."
    value: 2 * p_qpsk * (1 - p_qpsk)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 400.0]
    rotation: 0
    state: enabled
- name: cfo_hz
  id: variable_qtgui_range
  parameters:
    comment: 'Control de la ventana: diferencia de

      frecuencia entre los osciladores de A y B, en

      Hz (el receptor de B la ve como +CFO y el de A

      como -CFO).'
    gui_hint: 0,4,1,2
    label: "Desv\xEDo entre osciladores A-B [Hz]"
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-1000'
    step: '10'
    stop: '1000'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2416, 8.0]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable_qtgui_range
  parameters:
    comment: "Control de la ventana: ancho de banda de los\nlazos de Costas. M\xE1\
      s grande = corrige m\xE1s\nr\xE1pido, pero con m\xE1s ruido."
    gui_hint: 1,0,1,1
    label: BW lazo de Costas
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.005'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2680, 8.0]
    rotation: 0
    state: enabled
- name: ebn0_db
  id: variable_qtgui_range
  parameters:
    comment: 'Control de la ventana: Eb/N0 del canal en dB

      (0 a 15). Cambia el nivel del ruido (variable

      "ruido").'
    gui_hint: 0,0,1,2
    label: Eb/N0 [dB]
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.5'
    stop: '15'
    value: '10'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1888, 8.0]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: "Roll-off del filtro RRC (0,35): cu\xE1nto m\xE1s\nancho que el m\xED\
      nimo es el espectro. La se\xF1al\nocupa 125 k \xD7 1,35 \u2248 170 kHz."
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 264.0]
    rotation: 0
    state: enabled
- name: fase_deg
  id: variable_qtgui_range
  parameters:
    comment: 'Control de la ventana: fase que gira el canal,

      en grados. La corrige el lazo de Costas de

      cada receptor.'
    gui_hint: 0,2,1,2
    label: "Fase del canal [\xB0]"
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-180'
    step: '1'
    stop: '180'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2144, 8.0]
    rotation: 0
    state: enabled
- name: formato_trama
  id: variable_header_format_default
  parameters:
    access_code: '0'
    bps: '1'
    comment: "Formato del encabezado de cada trama:\npre\xE1mbulo de 64 bits (Access\
      \ Code 0 = el\npre\xE1mbulo est\xE1ndar de GNU Radio) + longitud\ndel payload\
      \ en 16 bits, escrita 2 veces. Lo\nusan los Protocol Formatter."
    threshold: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 40.0]
    rotation: 0
    state: enabled
- name: guarda
  id: variable
  parameters:
    comment: 'Muestras de silencio entre turnos (nadie

      transmite).'
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1600, 56.0]
    rotation: 0
    state: enabled
- name: lbl_A
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el BER medido por el\nnodo A desde que arranc\xF3\
      ."
    formatter: 'lambda x: ''%.2e'' % x'
    gui_hint: 1,3,1,1
    label: 'BER nodo A (acum.): '
    type: real
    value: 10**ber_A_log
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2416, 248.0]
    rotation: 0
    state: enabled
- name: lbl_B
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el BER medido por el\nnodo B desde que arranc\xF3\
      ."
    formatter: 'lambda x: ''%.2e'' % x'
    gui_hint: 1,4,1,1
    label: 'BER nodo B (acum.): '
    type: real
    value: 10**ber_B_log
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2952, 248.0]
    rotation: 0
    state: enabled
- name: lbl_ratio
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el cociente BER medido /\nBER te\xF3rico de cada\
      \ nodo (cerca de 1 = anda\ncomo dice la teor\xEDa)."
    formatter: 'lambda x: ''%.2f | %.2f'' % x'
    gui_hint: 1,5,1,1
    label: "Medido / te\xF3rico (A | B): "
    type: raw
    value: (10**ber_A_log / ber_teo, 10**ber_B_log / ber_teo)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3208, 248.0]
    rotation: 0
    state: enabled
- name: lbl_teo
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el BER te\xF3rico para el\nEb/N0 elegido."
    formatter: 'lambda x: ''%.2e'' % x'
    gui_hint: 1,2,1,1
    label: "BER te\xF3rico: "
    type: real
    value: ber_teo
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1888, 248.0]
    rotation: 0
    state: enabled
- name: mensaje_A
  id: variable
  parameters:
    comment: Texto que transmite el nodo A en cada trama.
    value: '"Hola, soy el nodo A. Este mensaje viaja por el canal compartido en mi
      ranura de tiempo (TDD)."'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 264.0]
    rotation: 0
    state: enabled
- name: mensaje_B
  id: variable
  parameters:
    comment: Texto que transmite el nodo B en cada trama.
    value: '"Hola, soy el nodo B. Respondo en la otra ranura: nunca transmitimos los
      dos al mismo tiempo!!"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 400.0]
    rotation: 0
    state: enabled
- name: p_qpsk
  id: variable
  parameters:
    comment: "p = Q(ra\xEDz(2 Eb/N0)): probabilidad de decidir\nmal un eje de la 4-QAM."
    value: 0.5 * math.erfc(math.sqrt(10**(ebn0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 400.0]
    rotation: 0
    state: enabled
- name: payload_A
  id: variable
  parameters:
    comment: "El mensaje del nodo A como lista de bytes\n(n\xFAmeros de 0 a 255)."
    value: list(mensaje_A.encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 264.0]
    rotation: 0
    state: enabled
- name: payload_B
  id: variable
  parameters:
    comment: El mensaje del nodo B como lista de bytes.
    value: list(mensaje_B.encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 400.0]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: "Constelaci\xF3n 4-QAM: 4 puntos (\xB10,707 \xB1 j0,707)\ncon c\xF3digo\
      \ Gray (Symbol Map 0, 1, 3, 2: los\nvecinos difieren en un solo bit). La usan\
      \ los\nmoduladores y los decisores."
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 8.0]
    rotation: 0
    state: enabled
- name: ranura
  id: variable
  parameters:
    comment: "Muestras de cada turno de transmisi\xF3n (2048 =\n512 s\xEDmbolos; tiene\
      \ que ser m\xFAltiplo de sps)."
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1336, 56.0]
    rotation: 0
    state: enabled
- name: ruido
  id: variable
  parameters:
    comment: "Amplitud del ruido que agrega el canal,\ncalculada para que haya el\
      \ Eb/N0 elegido: la\nse\xF1al tiene potencia 1 y 4 muestras por\ns\xEDmbolo,\
      \ y Es/N0 = 2 Eb/N0 (2 bits por\ns\xEDmbolo)."
    value: math.sqrt(sps / (2 * 10**(ebn0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 400.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: "Muestreo: 500 000 muestras por segundo. Con 4\nmuestras por s\xEDmbolo\
      \ son 125 000 s\xEDmbolos/s =\n250 kbit/s mientras un nodo transmite."
    value: '500000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 264.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "Muestras por s\xEDmbolo (4)."
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 264.0]
    rotation: 0
    state: enabled
- name: sync_bw
  id: variable_qtgui_range
  parameters:
    comment: "Control de la ventana: ancho de banda de los\nlazos del sincronismo\
      \ de s\xEDmbolo."
    gui_hint: 1,1,1,1
    label: "BW sinc. de s\xEDmbolo"
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.01'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2952, 8.0]
    rotation: 0
    state: enabled
- name: umbral
  id: variable
  parameters:
    comment: "Cu\xE1ntos bits del pre\xE1mbulo (de 64) pueden\nllegar mal y aun as\xED\
      \ se acepta la trama."
    value: '12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 56.0]
    rotation: 0
    state: enabled
- name: ventana
  id: variable
  parameters:
    comment: "Cantidad de bits que se promedian para el BER\n\"reciente\" (1 mill\xF3\
      n)."
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1600, 400.0]
    rotation: 0
    state: enabled
- name: acelerador
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: "Frena el flujo a 500 k\nmuestras/s (samp_rate): as\xED la\nsimulaci\xF3\
      n va a tiempo real y\nno usa toda la CPU.\nEntra: complejos.\nSale: los mismos\
      \ complejos, a\n  500 k/s."
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 2584.0]
    rotation: 0
    state: enabled
- name: canal_tx_A
  id: virtual_source
  parameters:
    alias: ''
    comment: "Toma sin cable la se\xF1al\ndel nodo A (Virtual Sink\n\"tx_A\").\nEntra:\
      \ nada a la vista.\nSale: complejos."
    stream_id: tx_A
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 2592.0]
    rotation: 0
    state: enabled
- name: canal_tx_B
  id: virtual_source
  parameters:
    alias: ''
    comment: "Toma sin cable la se\xF1al\ndel nodo B (Virtual Sink\n\"tx_B\").\nEntra:\
      \ nada a la vista.\nSale: complejos."
    stream_id: tx_B
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 3032.0]
    rotation: 0
    state: enabled
- name: conmutador_rx
  id: blocks_stream_demux
  parameters:
    affinity: ''
    alias: ''
    comment: "Conmutador de recepci\xF3n:\nreparte las muestras con los\nmismos turnos:\
      \ la ranura de A\nva a out0 (receptor de B), la\nde B a out2 (receptor de A)\
      \ y\nlas guardas a out1 y out3 (se\ntiran).\nEntra: complejos.\nSale: 4 salidas\
      \ de complejos."
    lengths: '[ranura, guarda, ranura, guarda]'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_outputs: '4'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1280, 2552.0]
    rotation: 0
    state: enabled
- name: fase
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: "Gira la constelaci\xF3n la\nfase elegida (multiplica\npor e^(j\xB7fase)).\n\
      Entra: complejos.\nSale: complejos girados."
    const: cmath.exp(1j * math.radians(fase_deg))
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [736, 2592.0]
    rotation: 0
    state: enabled
- name: g_canal_const
  id: qtgui_const_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '0.6'
    alpha10: '0.6'
    alpha2: '0.6'
    alpha3: '0.6'
    alpha4: '0.6'
    alpha5: '0.6'
    alpha6: '0.6'
    alpha7: '0.6'
    alpha8: '0.6'
    alpha9: '0.6'
    autoscale: 'False'
    axislabels: 'True'
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: "Gr\xE1fico (pesta\xF1a 1): constelaci\xF3n de las\nmuestras del canal,\
      \ con ruido y sin\nsincronizar.\nEntra: complejos.\nSale: nada (solo dibuja)."
    grid: 'True'
    gui_hint: 'pestanas@0: 1,2,1,1'
    label1: Canal
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'False'
    marker1: '0'
    marker10: '0'
    marker2: '0'
    marker3: '0'
    marker4: '0'
    marker5: '0'
    marker6: '0'
    marker7: '0'
    marker8: '0'
    marker9: '0'
    name: '"Muestras en el canal (con ruido)"'
    nconnections: '1'
    size: '1024'
    style1: '0'
    style10: '0'
    style2: '0'
    style3: '0'
    style4: '0'
    style5: '0'
    style6: '0'
    style7: '0'
    style8: '0'
    style9: '0'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_slope: qtgui.TRIG_SLOPE_POS
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    xmax: '3'
    xmin: '-3'
    ymax: '3'
    ymin: '-3'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1280, 2176.0]
    rotation: 0
    state: enabled
- name: g_canal_esp
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: "Gr\xE1fico (pesta\xF1a 1): espectro de lo que hay en\nel canal compartido.\n\
      Entra: complejos.\nSale: nada (solo dibuja)."
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 'pestanas@0: 0,2,1,1'
    label: '"Potencia relativa"'
    label1: Canal
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Espectro en el canal compartido"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-100'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1280, 2360.0]
    rotation: 0
