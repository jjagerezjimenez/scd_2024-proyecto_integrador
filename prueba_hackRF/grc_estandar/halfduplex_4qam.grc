    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_symbol: sps
    truncate: 'False'
    verbose: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 1304.0]
    rotation: 0
    state: enabled
- name: txB_trama
  id: blocks_tagged_stream_mux
  parameters:
    affinity: ''
    alias: ''
    comment: "Pone el encabezado delante del\npayload: arma la trama\ncompleta.\n\
      Entra: in0 = encabezado (12\n  bytes), in1 = payload + CRC\n  (L_B + 4 bytes).\n\
      Sale: bytes: trama de L_B + 16\n  bytes (packet_len)."
    lengthtagname: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    ninputs: '2'
    tag_preserve_head_pos: '0'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1032, 1320.0]
    rotation: 0
    state: enabled
- name: txB_vs
  id: virtual_sink
  parameters:
    alias: ''
    comment: "Conexi\xF3n sin cable: la se\xF1al del nodo B sigue\nen los Virtual\
      \ Source \"tx_B\" (canal compartido\ny gr\xE1ficos).\nEntra: complejos.\nSale:\
      \ nada a la vista."
    stream_id: tx_B
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1536, 1328.0]
    rotation: 0
    state: enabled

