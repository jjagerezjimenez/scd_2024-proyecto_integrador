options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: "Dos nodos que se turnan un canal compartido (TDD) con tramas (pre\xE1\
      mbulo + longitud + CRC-32), 4-QAM diferencial y medici\xF3n de BER; solo bloques\
      \ est\xE1ndar de GNU Radio"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: halfduplex_4qam
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Enlace half-duplex 4-QAM (TDD) con tramas y BER (bloques est\xE1ndar)"
    window_size: (1800, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: L_A
  id: variable
  parameters:
    comment: Bytes de payload del nodo A
    value: len(payload_A)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [992, 8.0]
    rotation: 0
    state: enabled
- name: L_B
  id: variable
  parameters:
    comment: Bytes de payload del nodo B
    value: len(payload_B)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 112.0]
    rotation: 0
    state: enabled
- name: ber_A_log
  id: variable_function_probe
  parameters:
    block_id: rxA_sonda_ber
    comment: ''
    function_args: ''
    function_name: level
    poll_rate: '4'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1872, 0.0]
    rotation: 0
    state: enabled
- name: ber_B_log
  id: variable_function_probe
  parameters:
    block_id: rxB_sonda_ber
    comment: ''
    function_args: ''
    function_name: level
    poll_rate: '4'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2008, 0.0]
    rotation: 0
    state: enabled
- name: ber_teo
  id: variable
  parameters:
    comment: "4-QAM con codificaci\xF3n diferencial: 2p(1-p)"
    value: 2 * p_qpsk * (1 - p_qpsk)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [784, 208.0]
    rotation: 0
    state: enabled
- name: cfo_hz
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,4,1,2
    label: "Desv\xEDo entre osciladores A-B [Hz]"
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-1000'
    step: '10'
    stop: '1000'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1688, 8.0]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,1
    label: BW lazo de Costas
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.005'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 152.0]
    rotation: 0
    state: enabled
- name: ebn0_db
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,0,1,2
    label: Eb/N0 [dB]
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.5'
    stop: '15'
    value: '10'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1432, 8.0]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: Factor de roll-off del filtro RRC
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [504, 16.0]
    rotation: 0
    state: enabled
- name: fase_deg
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,2,1,2
    label: "Fase del canal [\xB0]"
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-180'
    step: '1'
    stop: '180'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1552, 8.0]
    rotation: 0
    state: enabled
- name: formato_trama
  id: variable_header_format_default
  parameters:
    access_code: '0'
    bps: '1'
    comment: ''
    threshold: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1240, 112.0]
    rotation: 0
    state: enabled
- name: guarda
  id: variable
  parameters:
    comment: Muestras de silencio entre turnos (nadie transmite)
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 136.0]
    rotation: 0
    state: enabled
- name: lbl_A
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.2e'' % x'
    gui_hint: 1,3,1,1
    label: 'BER nodo A (acum.): '
    type: real
    value: 10**ber_A_log
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1840, 120.0]
    rotation: 0
    state: enabled
- name: lbl_B
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.2e'' % x'
    gui_hint: 1,4,1,1
    label: 'BER nodo B (acum.): '
    type: real
    value: 10**ber_B_log
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1992, 120.0]
    rotation: 0
    state: enabled
- name: lbl_ratio
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.2f | %.2f'' % x'
    gui_hint: 1,5,1,1
    label: "Medido / te\xF3rico (A | B): "
    type: raw
    value: (10**ber_A_log / ber_teo, 10**ber_B_log / ber_teo)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2152, 120.0]
    rotation: 0
    state: enabled
- name: lbl_teo
  id: variable_qtgui_label
  parameters:
    comment: ''
    formatter: 'lambda x: ''%.2e'' % x'
    gui_hint: 1,2,1,1
    label: "BER te\xF3rico: "
    type: real
    value: ber_teo
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1704, 208.0]
    rotation: 0
    state: enabled
- name: mensaje_A
  id: variable
  parameters:
    comment: Texto que transmite el nodo A
    value: '"Hola, soy el nodo A. Este mensaje viaja por el canal compartido en mi
      ranura de tiempo (TDD)."'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [328, 112.0]
    rotation: 0
    state: enabled
- name: mensaje_B
  id: variable
  parameters:
    comment: Texto que transmite el nodo B
    value: '"Hola, soy el nodo B. Respondo en la otra ranura: nunca transmitimos los
      dos al mismo tiempo!!"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 208.0]
    rotation: 0
    state: enabled
- name: p_qpsk
  id: variable
  parameters:
    comment: 'Q(raiz(2 Eb/N0)): 4-QAM coherente'
    value: 0.5 * math.erfc(math.sqrt(10**(ebn0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [336, 256.0]
    rotation: 0
    state: enabled
- name: payload_A
  id: variable
  parameters:
    comment: ''
    value: list(mensaje_A.encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 16.0]
    rotation: 0
    state: enabled
- name: payload_B
  id: variable
  parameters:
    comment: ''
    value: list(mensaje_B.encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 16.0]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1488, 304.0]
    rotation: 0
    state: enabled
- name: ranura
  id: variable
  parameters:
    comment: "Muestras de cada turno de transmisi\xF3n (m\xFAltiplo de sps)"
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 208.0]
    rotation: 0
    state: enabled
- name: ruido
  id: variable
  parameters:
    comment: "Desv\xEDo del ruido complejo: potencia de se\xF1al = 1 por muestra,\
      \ Es/N0 = 2 Eb/N0"
    value: math.sqrt(sps / (2 * 10**(ebn0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [16, 304.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Frecuencia de muestreo [muestras/s]
    value: '500000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "Muestras por s\xEDmbolo"
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [384, 16.0]
    rotation: 0
    state: enabled
- name: sync_bw
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,1,1,1
