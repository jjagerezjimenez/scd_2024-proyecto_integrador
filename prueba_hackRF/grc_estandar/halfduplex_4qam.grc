  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 8.0]
    rotation: 0
    state: enabled
- name: ventana
  id: variable
  parameters:
    comment: Bits de la ventana del BER 'reciente'
