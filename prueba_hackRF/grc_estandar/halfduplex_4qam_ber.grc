options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: "Opciones del flowgraph: SIN interfaz (No GUI),\npara medir. Lo compila\
      \ y lo corre\nrun_ber_sweep.py con distintos par\xE1metros\n(Eb/N0, fase, CFO,\
      \ ...); termina solo cuando\nel Head llega a \"muestras\"."
    copyright: ''
    description: "El mismo enlace half-duplex de halfduplex_4qam.grc, sin gr\xE1ficos,\
      \ para medir BER por l\xEDnea de comandos"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: halfduplex_4qam_ber
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Medici\xF3n de BER del enlace half-duplex 4-QAM (sin interfaz)"
    window_size: (1800, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 24.0]
    rotation: 0
    state: enabled

blocks:
- name: L_A
  id: variable
  parameters:
    comment: 'Bytes de payload de cada trama del nodo A

      (largo de su mensaje).'
    value: len(payload_A)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1328, 264.0]
    rotation: 0
    state: enabled
- name: L_B
  id: variable
  parameters:
    comment: Bytes de payload de cada trama del nodo B.
    value: len(payload_B)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1328, 400.0]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: "Roll-off del filtro RRC (0,35): cu\xE1nto m\xE1s\nancho que el m\xED\
      nimo es el espectro. La se\xF1al\nocupa 125 k \xD7 1,35 \u2248 170 kHz."
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 264.0]
    rotation: 0
    state: enabled
- name: formato_trama
  id: variable_header_format_default
  parameters:
    access_code: '0'
    bps: '1'
    comment: "Formato del encabezado de cada trama:\npre\xE1mbulo de 64 bits (Access\
      \ Code 0 = el\npre\xE1mbulo est\xE1ndar de GNU Radio) + longitud\ndel payload\
      \ en 16 bits, escrita 2 veces. Lo\nusan los Protocol Formatter."
    threshold: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 40.0]
    rotation: 0
    state: enabled
- name: guarda
  id: variable
  parameters:
    comment: 'Muestras de silencio entre turnos (nadie

      transmite).'
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1600, 56.0]
    rotation: 0
    state: enabled
- name: mensaje_A
  id: variable
  parameters:
    comment: Texto que transmite el nodo A en cada trama.
    value: '"Hola, soy el nodo A. Este mensaje viaja por el canal compartido en mi
      ranura de tiempo (TDD)."'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 264.0]
    rotation: 0
    state: enabled
- name: mensaje_B
  id: variable
  parameters:
    comment: Texto que transmite el nodo B en cada trama.
    value: '"Hola, soy el nodo B. Respondo en la otra ranura: nunca transmitimos los
      dos al mismo tiempo!!"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 400.0]
    rotation: 0
    state: enabled
- name: payload_A
  id: variable
  parameters:
    comment: "El mensaje del nodo A como lista de bytes\n(n\xFAmeros de 0 a 255)."
    value: list(mensaje_A.encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 264.0]
    rotation: 0
    state: enabled
- name: payload_B
  id: variable
  parameters:
    comment: El mensaje del nodo B como lista de bytes.
    value: list(mensaje_B.encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 400.0]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: "Constelaci\xF3n 4-QAM: 4 puntos (\xB10,707 \xB1 j0,707)\ncon c\xF3digo\
      \ Gray (Symbol Map 0, 1, 3, 2: los\nvecinos difieren en un solo bit). La usan\
      \ los\nmoduladores y los decisores."
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 8.0]
    rotation: 0
    state: enabled
- name: ranura
  id: variable
  parameters:
    comment: "Muestras de cada turno de transmisi\xF3n (2048 =\n512 s\xEDmbolos; tiene\
      \ que ser m\xFAltiplo de sps)."
    value: '2048'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1328, 56.0]
    rotation: 0
    state: enabled
- name: ruido
  id: variable
  parameters:
    comment: "Amplitud del ruido que agrega el canal,\ncalculada para que haya el\
      \ Eb/N0 elegido: la\nse\xF1al tiene potencia 1 y 4 muestras por\ns\xEDmbolo,\
      \ y Es/N0 = 2 Eb/N0 (2 bits por\ns\xEDmbolo)."
    value: math.sqrt(sps / (2 * 10**(ebn0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1832, 56.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: "Muestreo: 500 000 muestras por segundo. Con 4\nmuestras por s\xEDmbolo\
      \ son 125 000 s\xEDmbolos/s =\n250 kbit/s mientras un nodo transmite."
    value: '500000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 264.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "Muestras por s\xEDmbolo (4)."
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 264.0]
    rotation: 0
    state: enabled
- name: umbral
  id: variable
  parameters:
    comment: "Cu\xE1ntos bits del pre\xE1mbulo (de 64) pueden\nllegar mal y aun as\xED\
      \ se acepta la trama."
    value: '12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 56.0]
    rotation: 0
    state: enabled
- name: canal_tx_A
  id: virtual_source
  parameters:
    alias: ''
    comment: "Toma sin cable la se\xF1al\ndel nodo A (Virtual Sink\n\"tx_A\").\nEntra:\
      \ nada a la vista.\nSale: complejos."
    stream_id: tx_A
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1720.0]
    rotation: 0
    state: enabled
- name: canal_tx_B
  id: virtual_source
  parameters:
    alias: ''
    comment: "Toma sin cable la se\xF1al\ndel nodo B (Virtual Sink\n\"tx_B\").\nEntra:\
      \ nada a la vista.\nSale: complejos."
    stream_id: tx_B
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 2160.0]
    rotation: 0
    state: enabled
- name: cfo_hz
  id: parameter
  parameters:
    alias: ''
    comment: "Par\xE1metro: diferencia de frecuencia entre los\nosciladores de A y\
      \ B, en Hz (--cfo-hz)."
    hide: none
    label: Desvio entre osciladores A-B [Hz]
    short_id: ''
    type: eng_float
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2624, 8.0]
    rotation: 0
    state: enabled
- name: conmutador_rx
  id: blocks_stream_demux
  parameters:
    affinity: ''
    alias: ''
    comment: "Conmutador de recepci\xF3n:\nreparte las muestras con los\nmismos turnos:\
      \ la ranura de A\nva a out0 (receptor de B), la\nde B a out2 (receptor de A)\
      \ y\nlas guardas a out1 y out3 (se\ntiran).\nEntra: complejos.\nSale: 4 salidas\
      \ de complejos."
    lengths: '[ranura, guarda, ranura, guarda]'
    maxoutbuf: '0'
    minoutbuf: '0'
    num_outputs: '4'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1120, 1680.0]
    rotation: 0
    state: enabled
- name: costas_bw
  id: parameter
  parameters:
    alias: ''
    comment: "Par\xE1metro: ancho de banda de los lazos de\nCostas (0 = no corrigen\
      \ la fase)\n(--costas-bw)."
    hide: none
    label: BW del lazo de Costas (0 = sin corregir fase)
    short_id: ''
    type: eng_float
    value: '0.005'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2872, 8.0]
    rotation: 0
    state: enabled
- name: descartar
  id: parameter
  parameters:
    alias: ''
    comment: "Par\xE1metro: bits que no se cuentan al comienzo,\nmientras se enganchan\
      \ los lazos (--descartar)."
    hide: none
    label: Bits descartados al inicio (enganche de los lazos)
    short_id: ''
    type: intx
    value: '100000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2872, 184.0]
    rotation: 0
    state: enabled
- name: ebn0_db
  id: parameter
  parameters:
    alias: ''
    comment: "Par\xE1metro: Eb/N0 del canal en dB.\nrun_ber_sweep.py lo cambia en\
      \ cada medici\xF3n\n(--ebn0-db)."
    hide: none
    label: Eb/N0 [dB]
    short_id: ''
    type: eng_float
    value: '6.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2104, 8.0]
    rotation: 0
    state: enabled
- name: fase
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: "Gira la constelaci\xF3n la\nfase elegida (multiplica\npor e^(j\xB7fase)).\n\
      Entra: complejos.\nSale: complejos girados."
    const: cmath.exp(1j * math.radians(fase_deg))
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 1720.0]
    rotation: 0
    state: enabled
- name: fase_deg
  id: parameter
  parameters:
    alias: ''
    comment: "Par\xE1metro: fase que gira el canal, en grados\n(--fase-deg)."
    hide: none
    label: Fase del canal [grados]
    short_id: ''
    type: eng_float
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2368, 8.0]
    rotation: 0
    state: enabled
- name: guarda_1
  id: blocks_null_sink
  parameters:
    affinity: ''
    alias: ''
    bus_structure_sink: '[[0,],]'
    comment: 'Tira la guarda que

      sigue al turno de A.

      Entra: complejos.

      Sale: nada.'
    num_inputs: '1'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 2008.0]
    rotation: 0
    state: enabled
- name: guarda_3
  id: blocks_null_sink
  parameters:
    affinity: ''
    alias: ''
    bus_structure_sink: '[[0,],]'
    comment: 'Tira la guarda que

      sigue al turno de B.

      Entra: complejos.

      Sale: nada.'
    num_inputs: '1'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 2328.0]
    rotation: 0
    state: enabled
- name: imports
  id: import
  parameters:
    alias: ''
    comment: "M\xF3dulos de Python que usan las variables y los\nbloques: math y cmath\
      \ (cuentas con n\xFAmeros\ncomplejos)."
    imports: import math, cmath
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 64.0]
    rotation: 0
    state: enabled
- name: limite
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: "Deja pasar solo \"muestras\"\nmuestras y despu\xE9s termina\nel flujo:\
      \ as\xED el flowgraph\ntermina solo y\nrun_ber_sweep.py lee los\nresultados.\n\
      Entra: complejos.\nSale: los mismos complejos,\n  hasta el l\xEDmite."
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: muestras
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [512, 1720.0]
    rotation: 0
    state: enabled
- name: muestras
  id: parameter
  parameters:
    alias: ''
    comment: "Par\xE1metro: cu\xE1ntas muestras del canal\ncompartido se simulan antes\
      \ de terminar\n(--muestras)."
    hide: none
    label: Muestras del canal compartido
    short_id: ''
    type: intx
    value: '4000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2368, 184.0]
    rotation: 0
    state: enabled
- name: nota_tdd
  id: note
  parameters:
    alias: ''
    comment: "CANAL COMPARTIDO (TDD)\nStream Mux = turnos [A | guarda | B | guarda];\n\
      Head limita la cantidad de muestras y hace que\nel flowgraph termine solo; Stream\
      \ Demux =\nconmutador de recepci\xF3n."
    note: "CANAL COMPARTIDO (TDD): Stream Mux = turnos [A | guarda | B | guarda];\
      \ Head limita la cantidad de muestras y hace que el flowgraph termine solo;\
      \ Stream Demux = conmutador de recepci\xF3n."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1528.0]
    rotation: 0
    state: enabled
- name: nota_tx
  id: note
  parameters:
    alias: ''
    comment: "TRANSMISORES\ncada nodo arma sus tramas (mensaje -> CRC-32\n-> pre\xE1\
      mbulo de 64 bits + longitud \xD72) y las\nmodula en 4-QAM diferencial con filtro\
      \ RRC."
    note: TRANSMISORES de los nodos A y B (igual que halfduplex_4qam.grc)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 560.0]
    rotation: 0
    state: enabled
- name: osc_rxA
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: "Oscilador del receptor de A: le agrega a lo\nque transmiti\xF3 B el\
      \ desv\xEDo -CFO (signo opuesto\nal que ve B).\nEntra: complejos (ranuras de\
      \ B).\nSale: complejos con -CFO."
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: -2 * math.pi * cfo_hz / samp_rate
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1352, 2152.0]
    rotation: 0
    state: enabled
- name: osc_rxB
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: "Oscilador del receptor de B: le agrega a lo\nque transmiti\xF3 A el\
      \ desv\xEDo de frecuencia +CFO\n(la diferencia entre los osciladores de los\n\
      dos nodos).\nEntra: complejos (ranuras de A).\nSale: complejos con +CFO."
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: 2 * math.pi * cfo_hz / samp_rate
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1352, 1712.0]
    rotation: 0
    state: enabled
- name: ruido_awgn
  id: analog_noise_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: ruido
    comment: "Genera ruido blanco gaussiano complejo, con la\namplitud \"ruido\" (seg\xFA\
      n el Eb/N0 elegido).\nEntra: nada (es una fuente).\nSale: complejos (ruido)."
    maxoutbuf: '0'
    minoutbuf: '0'
    noise_type: analog.GR_GAUSSIAN
    seed: semilla
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [688, 1984.0]
    rotation: 0
    state: enabled
- name: rxA_a_bits
  id: blocks_unpack_k_bits_bb
  parameters:
    affinity: ''
    alias: ''
    comment: "Separa cada n\xFAmero en sus 2 bits (primero el\nm\xE1s significativo).\n\
      Entra: bytes con 2 bits \xFAtiles (0 a 3).\nSale: bits sueltos (1 bit por byte:\
      \ 0 o 1)."
    k: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1968, 3120.0]
    rotation: 0
    state: enabled
- name: rxA_a_bytes
  id: blocks_repack_bits_bb
  parameters:
    affinity: ''
    alias: ''
    align_output: 'True'
    comment: "Junta los bits de a 8 para volver a formar\nbytes, respetando d\xF3\
      nde empieza cada trama\n(packet_len).\nEntra: bits sueltos (1 por byte).\nSale:\
      \ bytes: L_B + 4 por trama (packet_len)."
    endianness: gr.GR_MSB_FIRST
    k: '1'
    l: '8'
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '70000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2504, 3112.0]
    rotation: 0
    state: enabled
- name: rxA_a_pdu
  id: pdu_tagged_stream_to_pdu
  parameters:
    affinity: ''
    alias: ''
    comment: 'Convierte cada payload correcto (marcado con

      packet_len) en un mensaje (PDU).

      Entra: bytes con packet_len.

      Sale: mensajes (PDU).'
    maxoutbuf: '0'
    minoutbuf: '0'
    tag: '"packet_len"'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3008, 3120.0]
    rotation: 0
    state: enabled
- name: rxA_alinear
  id: blocks_tagged_stream_align
  parameters:
    affinity: ''
    alias: ''
    comment: "Descarta los bits que llegan antes\nde la primera etiqueta\ninicio_trama:\
      \ as\xED lo recibido\narranca justo despu\xE9s de un\npre\xE1mbulo, alineado\
      \ con la copia\ndel transmisor.\nEntra: bits con etiquetas.\nSale: bits alineados."
    lengthtagname: '"inicio_trama"'
    maxoutbuf: '0'
    minoutbuf: '0'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 3448.0]
    rotation: 0
    state: enabled
- name: rxA_costas
  id: digital_costas_loop_cc
  parameters:
    affinity: ''
    alias: ''
    comment: "Lazo de Costas de orden 4: corrige\nla fase y el desv\xEDo de frecuencia\n\
      del canal, para que la\nconstelaci\xF3n quede quieta en los 4\npuntos.\nEntra:\
      \ complejos, 1 muestra por\n  s\xEDmbolo.\nSale: out0 = s\xEDmbolos corregidos\n\
      \  (complejos); out1 a out3 =\n  frecuencia, fase y error (no se\n  usan)."
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '4'
    use_snr: 'False'
    w: costas_bw
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [936, 3080.0]
    rotation: 0
    state: enabled
- name: rxA_crc
  id: digital_crc32_bb
  parameters:
    affinity: ''
    alias: ''
    check: 'True'
    comment: "Vuelve a calcular el CRC-32 de\ncada trama: si coincide, la deja\npasar\
      \ sin los 4 bytes del CRC;\nsi no, la descarta (ten\xEDa\nerrores).\nEntra:\
      \ bytes: payload + CRC (L_B\n  + 4).\nSale: bytes: payloads correctos\n  (L_B\
      \ bytes cada uno)."
    lengthtagname: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '70000'
    packed: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2784, 3104.0]
    rotation: 0
    state: enabled
- name: rxA_dec_diferencial
  id: digital_diff_decoder_bb
  parameters:
    affinity: ''
    alias: ''
    coding: digital.DIFF_DIFFERENTIAL
    comment: "Decodificaci\xF3n diferencial: resta el s\xEDmbolo\nanterior (m\xF3\
      dulo 4), o sea, mide el cambio de\nfase. Por eso no importa si Costas qued\xF3\
      \ngirado 90\xB0, 180\xB0 o 270\xB0.\nEntra: s\xEDmbolos 0 a 3 (bytes).\nSale:\
      \ s\xEDmbolos 0 a 3 (el cambio de fase)."
    maxoutbuf: '0'
    minoutbuf: '0'
    modulus: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1424, 3112.0]
    rotation: 0
    state: enabled
- name: rxA_decisor
  id: digital_constellation_decoder_cb
  parameters:
    affinity: ''
    alias: ''
    comment: "Decide a cu\xE1l de los 4 puntos de la\nconstelaci\xF3n est\xE1 m\xE1\
