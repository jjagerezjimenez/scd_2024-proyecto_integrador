options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: "Opciones del flowgraph: t\xEDtulo de la ventana,\ninterfaz QT GUI y\
      \ nombre del programa que arma\nGRC al apretar F6 (enlace_4qam_tramas.py, en\n\
      esta misma carpeta)."
    copyright: ''
    description: "Enlace 4-QAM con tramas (pre\xE1mbulo + longitud + CRC-32) y medici\xF3\
      n de BER, solo bloques est\xE1ndar de GNU Radio"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: enlace_4qam_tramas
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Enlace 4-QAM con tramas y BER (bloques est\xE1ndar)"
    window_size: (1800, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 32.0]
    rotation: 0
    state: enabled

blocks:
- name: L
  id: variable
  parameters:
    comment: 'Bytes de payload por trama (largo del

      mensaje).'
    value: len(payload)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 400.0]
    rotation: 0
    state: enabled
- name: ber_acum_log
  id: variable_function_probe
  parameters:
    block_id: sonda_ber_acum
    comment: 'Lee 4 veces por segundo el log10 del BER

      acumulado (bloque "sonda_ber_acum").'
    function_args: ''
    function_name: level
    poll_rate: '4'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1896, 240.0]
    rotation: 0
    state: enabled
- name: ber_rec
  id: variable_function_probe
  parameters:
    block_id: sonda_ber_ventana
    comment: "Lee 4 veces por segundo el BER del \xFAltimo\nmill\xF3n de bits (bloque\
      \ \"sonda_ber_ventana\")."
    function_args: ''
    function_name: level
    poll_rate: '4'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2424, 240.0]
    rotation: 0
    state: enabled
- name: ber_teo
  id: variable
  parameters:
    comment: "BER te\xF3rico de 4-QAM con codificaci\xF3n\ndiferencial: 2 p (1 - p).\
      \ Un bit sale mal si\nexactamente uno de los dos s\xEDmbolos que se\ncomparan\
      \ se decidi\xF3 mal."
    value: 2 * p_qpsk * (1 - p_qpsk)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 400.0]
    rotation: 0
    state: enabled
- name: bits_trama
  id: variable
  parameters:
    comment: "Bits de cada trama: pre\xE1mbulo 64 + longitud 2\n\xD7 16 + payload\
      \ + CRC-32."
    value: 8*(8 + 4 + L + 4)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 400.0]
    rotation: 0
    state: enabled
- name: cfo_hz
  id: variable_qtgui_range
  parameters:
    comment: "Control de la ventana: desv\xEDo de frecuencia\ndel canal (CFO), en\
      \ Hz. Lo corrige el lazo de\nCostas."
    gui_hint: 0,4,1,2
    label: CFO [Hz]
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-1000'
    step: '10'
    stop: '1000'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2152, 8.0]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable_qtgui_range
  parameters:
    comment: "Control de la ventana: ancho de banda del lazo\nde Costas. M\xE1s grande\
      \ = corrige m\xE1s r\xE1pido,\npero con m\xE1s ruido."
    gui_hint: 1,0,1,1
    label: BW lazo de Costas
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.005'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2424, 8.0]
    rotation: 0
    state: enabled
- name: ebn0_db
  id: variable_qtgui_range
  parameters:
    comment: 'Control de la ventana: Eb/N0 del canal en dB

      (0 a 15). Cambia el nivel del ruido (variable

      "ruido").'
    gui_hint: 0,0,1,2
    label: Eb/N0 [dB]
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.5'
    stop: '15'
    value: '10'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1648, 8.0]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: "Roll-off del filtro RRC (0,35): cu\xE1nto m\xE1s\nancho que el m\xED\
      nimo es el espectro. La se\xF1al\nocupa 125 k \xD7 1,35 \u2248 170 kHz."
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 264.0]
    rotation: 0
    state: enabled
- name: fase_deg
  id: variable_qtgui_range
  parameters:
    comment: 'Control de la ventana: fase que gira el canal,

      en grados. La corrige el lazo de Costas.'
    gui_hint: 0,2,1,2
    label: "Fase del canal [\xB0]"
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-180'
    step: '1'
    stop: '180'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1896, 8.0]
    rotation: 0
    state: enabled
- name: formato_trama
  id: variable_header_format_default
  parameters:
    access_code: '0'
    bps: '1'
    comment: "Formato del encabezado de cada trama:\npre\xE1mbulo de 64 bits (Access\
      \ Code 0 = el\npre\xE1mbulo est\xE1ndar de GNU Radio) + longitud\ndel payload\
      \ en 16 bits, escrita 2 veces. Lo\nusan los Protocol Formatter."
    threshold: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 40.0]
    rotation: 0
    state: enabled
- name: lbl_acum
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el BER medido desde que\narranc\xF3."
    formatter: 'lambda x: ''%.2e'' % x'
    gui_hint: 1,3,1,1
    label: 'BER medido (acum.): '
    type: real
    value: 10**ber_acum_log
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2152, 248.0]
    rotation: 0
    state: enabled
- name: lbl_ratio
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el cociente BER medido /\nBER te\xF3rico (cerca\
      \ de 1 = el receptor anda\ncomo dice la teor\xEDa)."
    formatter: 'lambda x: ''%.2f'' % x'
    gui_hint: 1,5,1,1
    label: "Medido (\xFAltimo Mbit) / te\xF3rico: "
    type: real
    value: ber_rec / ber_teo
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2952, 248.0]
    rotation: 0
    state: enabled
- name: lbl_rec
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el BER del \xFAltimo mill\xF3n\nde bits."
    formatter: 'lambda x: ''%.2e'' % x'
    gui_hint: 1,4,1,1
    label: "BER medido (\xFAltimo Mbit): "
    type: real
    value: ber_rec
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2688, 248.0]
    rotation: 0
    state: enabled
- name: lbl_teo
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el BER te\xF3rico para el\nEb/N0 elegido."
    formatter: 'lambda x: ''%.2e'' % x'
    gui_hint: 1,2,1,1
    label: "BER te\xF3rico: "
    type: real
    value: ber_teo
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1648, 248.0]
    rotation: 0
    state: enabled
- name: mensaje
  id: variable
  parameters:
    comment: 'Texto que viaja en el payload de cada trama

      (todas las tramas llevan el mismo mensaje).'
    value: '"Sistemas de Comunicaciones Digitales - FACET UNT - enlace 4-QAM half-duplex
      en GNU Radio!!!!!!!!"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 264.0]
    rotation: 0
    state: enabled
- name: p_qpsk
  id: variable
  parameters:
    comment: "p = Q(ra\xEDz(2 Eb/N0)): probabilidad de decidir\nmal un eje de la 4-QAM."
    value: 0.5 * math.erfc(math.sqrt(10**(ebn0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 400.0]
    rotation: 0
    state: enabled
- name: payload
  id: variable
  parameters:
    comment: "El mensaje como lista de bytes (n\xFAmeros de 0 a\n255)."
    value: list(mensaje.encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 264.0]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: "Constelaci\xF3n 4-QAM: 4 puntos (\xB10,707 \xB1 j0,707)\ncon c\xF3digo\
      \ Gray (Symbol Map 0, 1, 3, 2: los\nvecinos difieren en un solo bit). La usan\
      \ el\nmodulador y el decisor."
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 8.0]
    rotation: 0
    state: enabled
- name: ruido
  id: variable
  parameters:
    comment: "Amplitud del ruido que agrega el canal,\ncalculada para que haya el\
      \ Eb/N0 elegido: la\nse\xF1al tiene potencia 1 y 4 muestras por\ns\xEDmbolo,\
      \ y Es/N0 = 2 Eb/N0 (2 bits por\ns\xEDmbolo)."
    value: math.sqrt(sps / (2 * 10**(ebn0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 400.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: "Muestreo: 500 000 muestras por segundo. Con 4\nmuestras por s\xEDmbolo\
      \ son 125 000 s\xEDmbolos/s =\n250 kbit/s."
    value: '500000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 264.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "Muestras por s\xEDmbolo (4)."
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 264.0]
    rotation: 0
    state: enabled
- name: sync_bw
  id: variable_qtgui_range
  parameters:
    comment: "Control de la ventana: ancho de banda del lazo\ndel sincronismo de s\xED\
      mbolo."
    gui_hint: 1,1,1,1
    label: "BW sinc. de s\xEDmbolo"
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.01'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2688, 8.0]
    rotation: 0
    state: enabled
- name: umbral
  id: variable
  parameters:
    comment: "Cu\xE1ntos bits del pre\xE1mbulo (de 64) pueden\nllegar mal y aun as\xED\
      \ se acepta la trama."
    value: '12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1088, 56.0]
    rotation: 0
    state: enabled
- name: ventana
  id: variable
  parameters:
    comment: "Cantidad de bits que se promedian para el BER\n\"reciente\" (1 mill\xF3\
      n)."
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1360, 400.0]
    rotation: 0
    state: enabled
- name: a_bits
  id: blocks_unpack_k_bits_bb
  parameters:
    affinity: ''
    alias: ''
    comment: "Separa cada n\xFAmero en sus 2 bits (primero el\nm\xE1s significativo).\n\
      Entra: bytes con 2 bits \xFAtiles (0 a 3), 125\n  k/s.\nSale: bits sueltos (1\
      \ bit por byte: 0 o 1),\n  250 k/s."
    k: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1992, 2552.0]
    rotation: 0
    state: enabled
- name: a_bytes
  id: blocks_repack_bits_bb
  parameters:
    affinity: ''
    alias: ''
    align_output: 'True'
    comment: "Junta los bits de a 8 para volver a formar\nbytes, respetando d\xF3\
      nde empieza cada trama\n(packet_len).\nEntra: bits sueltos (1 por byte).\nSale:\
      \ bytes: L + 4 por trama (packet_len)."
    endianness: gr.GR_MSB_FIRST
    k: '1'
    l: '8'
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '70000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 3768.0]
    rotation: 0
    state: enabled
- name: a_paquetes
  id: blocks_stream_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: "Corta el flujo en grupos de L bytes\n(uno por trama) y marca el comienzo\n\
      de cada grupo con la etiqueta\npacket_len. As\xED los bloques\nsiguientes saben\
      \ d\xF3nde empieza y\ntermina cada trama.\nEntra: bytes sin marcas.\nSale: los\
      \ mismos bytes, en grupos de\n  L marcados con packet_len."
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_len: L
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 848.0]
    rotation: 0
    state: enabled
- name: a_pdu
  id: pdu_tagged_stream_to_pdu
  parameters:
    affinity: ''
    alias: ''
    comment: 'Convierte cada payload correcto (marcado con

      packet_len) en un mensaje (PDU).

      Entra: bytes con packet_len.

      Sale: mensajes (PDU).'
    maxoutbuf: '0'
    minoutbuf: '0'
    tag: '"packet_len"'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1048, 3776.0]
    rotation: 0
    state: enabled
- name: acelerador
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: "Frena el flujo a 500 k\nmuestras/s (samp_rate): as\xED la\nsimulaci\xF3\
      n va a tiempo real y\nno usa toda la CPU.\nEntra: complejos.\nSale: los mismos\
      \ complejos, a\n  500 k/s."
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 848.0]
    rotation: 0
    state: enabled
- name: alinear
  id: blocks_tagged_stream_align
  parameters:
    affinity: ''
    alias: ''
    comment: "Descarta los bits que llegan antes\nde la primera etiqueta\ninicio_trama:\
      \ as\xED lo recibido\narranca justo despu\xE9s de un\npre\xE1mbulo, alineado\
      \ con la copia\ndel transmisor.\nEntra: bits con etiquetas.\nSale: bits alineados."
    lengthtagname: '"inicio_trama"'
    maxoutbuf: '0'
    minoutbuf: '0'
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 4552.0]
    rotation: 0
    state: enabled
- name: archivo_mensajes
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: 'Guarda esos mensajes en mensajes_recibidos.txt

      (en la carpeta de este .grc).

      Entra: bytes.

      Sale: nada (escribe el archivo).'
    file: '"mensajes_recibidos.txt"'
    type: byte
    unbuffered: 'True'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1336, 4072.0]
    rotation: 0
    state: enabled
- name: ber_ventana
  id: blocks_moving_average_xx
  parameters:
    affinity: ''
    alias: ''
    comment: "Promedia los errores en el \xFAltimo mill\xF3n de\nbits: da el BER reciente.\n\
      Entra: reales (0 o 1).\nSale: reales: BER."
    length: ventana
    max_iter: '4000'
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: 1.0/ventana
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2352, 4528.0]
    rotation: 0
    state: enabled
- name: bits_tx_float
  id: blocks_char_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: "Pasa cada bit a n\xFAmero real, para el gr\xE1fico.\nEntra: bytes (0\
      \ o 1).\nSale: reales."
    maxoutbuf: '0'
    minoutbuf: '0'
    scale: '1'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 1104.0]
    rotation: 0
    state: enabled
- name: bits_tx_unpack
  id: blocks_unpack_k_bits_bb
  parameters:
    affinity: ''
    alias: ''
    comment: 'Separa cada byte de la trama en sus 8 bits,

      para graficarlos.

      Entra: bytes.

      Sale: bits sueltos (0 o 1, 1 por byte).'
    k: '8'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1288, 1104.0]
    rotation: 0
    state: enabled
- name: cfo
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: "Agrega el desv\xEDo de\nfrecuencia (CFO): la se\xF1al\ngira cada vez\
      \ m\xE1s\n(multiplica por\ne^(j\xB72\u03C0\xB7CFO\xB7t)).\nEntra: complejos.\n\
      Sale: complejos con CFO."
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: 2 * math.pi * cfo_hz / samp_rate
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2656, 776.0]
    rotation: 0
    state: enabled
- name: cfo_real
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: cfo_hz
    comment: 'Genera un valor constante igual al CFO

      elegido, para compararlo con lo que estima

      Costas.

      Entra: nada (es una fuente).

      Sale: reales (Hz).'
    freq: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate/sps
    showports: 'False'
    type: float
    waveform: analog.GR_CONST_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1128, 3040.0]
    rotation: 0
    state: enabled
- name: comparar
  id: blocks_xor_xx
  parameters:
    affinity: ''
    alias: ''
    comment: "Compara bit a bit lo recibido con lo\ntransmitido (XOR): sale 1 donde\
      \ hay un error y\n0 donde coinciden.\nEntra: in0 = bits recibidos, in1 = bits\n\
      \  transmitidos (1 por byte).\nSale: bytes: 1 = error, 0 = bien."
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: byte
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1816, 4544.0]
    rotation: 0
    state: enabled
- name: consola
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: '(Deshabilitado) Si se habilita, escribe cada

      mensaje recibido en la consola de GRC.

      Entra: mensajes (PDU).

      Sale: nada.'
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1368, 3736.0]
    rotation: 0
    state: disabled
- name: costas
  id: digital_costas_loop_cc
  parameters:
    affinity: ''
    alias: ''
    comment: "Lazo de Costas de orden 4: corrige\nla fase y el desv\xEDo de frecuencia\n\
      del canal, para que la\nconstelaci\xF3n quede quieta en los 4\npuntos.\nEntra:\
      \ complejos, 1 muestra por\n  s\xEDmbolo.\nSale: out0 = s\xEDmbolos corregidos\n\
      \  (complejos); out1 = frecuencia\n  que corrige (rad/s\xEDmbolo); out2\n  =\
      \ fase y out3 = error (no se\n  usan)."
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '4'
