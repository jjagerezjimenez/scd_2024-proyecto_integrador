- name: sinc_simbolo
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: "Sincronismo de s\xEDmbolo: encuentra el mejor\ninstante para muestrear\
      \ cada s\xEDmbolo (el\ncentro del ojo) y entrega una muestra por\ns\xEDmbolo.\n\
      Entra: complejos, 4 muestras por s\xEDmbolo (500\n  k/s).\nSale: out0 = complejos,\
      \ 1 muestra por s\xEDmbolo\n  (125 k/s); out1 = error, out2 = per\xEDodo\n \
      \ instant\xE1neo y out3 = per\xEDodo promedio del\n  reloj (reales)."
    constellation: digital.constellation_bpsk().base()
    damping: '1.0'
    loop_bw: sync_bw
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: '128'
    osps: '1'
    pfb_mf_taps: '[]'
    resamp_type: digital.IR_MMSE_8TAP
    sps: sps
    ted_gain: '1.0'
    ted_type: digital.TED_SIGNAL_TIMES_SLOPE_ML
    type: cc
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [528, 2496.0]
    rotation: 0
    state: enabled
