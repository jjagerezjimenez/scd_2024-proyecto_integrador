- name: crc_tx
  id: digital_crc32_bb
  parameters:
    affinity: ''
    alias: ''
    check: 'False'
    comment: 'Calcula el CRC-32 de cada payload y se lo

      agrega al final (4 bytes). El receptor lo

      vuelve a calcular para descartar las tramas

      con errores.

      Entra: bytes: payload de L bytes (packet_len).

      Sale: bytes: payload + CRC = L + 4 bytes.'
    lengthtagname: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packed: 'True'
  states:
