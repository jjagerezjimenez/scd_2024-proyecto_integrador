    alias: ''
    comment: "Pone el encabezado delante del\npayload: arma la trama\ncompleta.\n\
      Entra: in0 = encabezado (12\n  bytes), in1 = payload + CRC\n  (L + 4 bytes).\n\
      Sale: bytes: trama de L + 16\n  bytes (packet_len)."
    lengthtagname: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    ninputs: '2'
    tag_preserve_head_pos: '0'
