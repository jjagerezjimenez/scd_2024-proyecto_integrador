      \ complejos, 1 muestra por\n  s\xEDmbolo.\nSale: out0 = s\xEDmbolos corregidos\n\
      \  (complejos); out1 = frecuencia,\n  out2 = fase, out3 = error\n  (reales)."
    maxoutbuf: '0'
    minoutbuf: '0'
    order: '4'
    use_snr: 'False'
