options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: "Opciones del flowgraph: t\xEDtulo de la ventana,\ninterfaz QT GUI y\
      \ nombre del programa que arma\nGRC al apretar F6 (hackrf_rx_archivo.py, en\n\
      esta misma carpeta)."
    copyright: ''
    description: "Recibe con un HackRF los paquetes de hackrf_tx_archivo.grc (FLL,\
      \ sincronismo, Costas, CRC-32) y guarda los correctos en paquetes_recibidos.bin\
      \ y datos_recibidos.bin; solo bloques est\xE1ndar de GNU Radio"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hackrf_rx_archivo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "HackRF RX: recepci\xF3n de un archivo (4-QAM, bloques est\xE1ndar)"
    window_size: (1850, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 32.0]
    rotation: 0
    state: enabled

blocks:
- name: N
  id: variable
  parameters:
    comment: "Bytes del archivo en cada paquete. Tiene que\nser el mismo n\xFAmero\
      \ que en el transmisor."
    value: '200'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 392.0]
    rotation: 0
    state: enabled
- name: amp_rx
  id: variable_qtgui_check_box
  parameters:
    comment: 'Casilla de la ventana: prende el amplificador

      extra del RX (+11 dB). Empezar con la casilla

      apagada.'
    'false': 'False'
    gui_hint: 0,1,1,1
    label: Amplificador RX (+11 dB)
    'true': 'True'
    type: bool
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1672, 16.0]
    rotation: 0
    state: enabled
- name: ber_est
  id: variable
  parameters:
    comment: "BER te\xF3rico de 4-QAM con codificaci\xF3n\ndiferencial: 2 p (1 - p)\
      \ (cada error del canal\narruina 2 bits)."
    value: 2 * p_est * (1 - p_est)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 1088.0]
    rotation: 0
    state: enabled
- name: cfo_hz
  id: variable
  parameters:
    comment: "Desv\xEDo de frecuencia de la se\xF1al recibida, en\nHz: suma lo que\
      \ corrigen el FLL y Costas (los\ndos corrigen con el signo opuesto al desv\xED\
      o)."
    value: -(w_fll * samp_rate_rx + w_costas * samp_rate_rx / sps) / (2 * math.pi)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 952.0]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable_qtgui_range
  parameters:
    comment: "Control de la ventana: ancho de banda del lazo\nde Costas (corrige la\
      \ fase que le queda a la\nse\xF1al)."
    gui_hint: 1,1,1,1
    label: BW lazo de Costas
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.01'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1672, 224.0]
    rotation: 0
    state: enabled
- name: decim
  id: variable
  parameters:
    comment: "Diezmado: despu\xE9s de filtrar el canal se queda\n1 de cada 2 muestras\
      \ (2 M -> 1 M muestras/s)."
    value: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 248.0]
    rotation: 0
    state: enabled
- name: dispositivo
  id: variable
  parameters:
    comment: "Qu\xE9 HackRF usar: \"serial=...\" (el n\xFAmero lo\nmuestra hackrf_info).\
      \ Vac\xEDo = la primera que\nencuentre."
    value: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 56.0]
    rotation: 0
    state: enabled
- name: eb_n0_db
  id: variable
  parameters:
    comment: "Eb/N0 = Es/N0 - 3 dB (cada s\xEDmbolo lleva 2\nbits)."
    value: es_n0_db - 10 * math.log10(2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 952.0]
    rotation: 0
    state: enabled
- name: es_n0_db
  id: variable_function_probe
  parameters:
    block_id: estimador_snr
    comment: 'Lee 2 veces por segundo el Es/N0 (en dB) que

      calcula el bloque "estimador_snr".'
    function_args: ''
    function_name: snr
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 776.0]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: 'Roll-off del filtro RRC (0,35), igual que en

      el transmisor. Lo usan el FLL y el filtro

      adaptado.'
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1112, 248.0]
    rotation: 0
    state: enabled
- name: f_offset
  id: variable
  parameters:
    comment: "Corrimiento digital de 400 kHz (igual que en\nel transmisor): la HackRF\
      \ se sintoniza 400 kHz\nm\xE1s abajo, as\xED que la se\xF1al llega en +400 kHz."
    value: 400e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 392.0]
    rotation: 0
    state: enabled
- name: fll_bw
  id: variable_qtgui_range
  parameters:
    comment: "Control de la ventana: ancho de banda del lazo\ndel FLL. M\xE1s grande\
      \ = engancha m\xE1s r\xE1pido pero\ncon m\xE1s ruido."
    gui_hint: 1,0,1,1
    label: BW lazo FLL
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.005'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 224.0]
    rotation: 0
    state: enabled
- name: freq_mhz
  id: variable_qtgui_entry
  parameters:
    comment: 'Casilla de la ventana: frecuencia de la

      portadora en MHz (la misma que en el

      transmisor). Se aplica al apretar Enter.'
    entry_signal: editingFinished
    gui_hint: 0,0,1,1
    label: Frecuencia [MHz]
    type: real
    value: '915'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 32.0]
    rotation: 0
    state: enabled
- name: items_detectados
  id: variable_function_probe
  parameters:
    block_id: detector_trama
    comment: "Lee 2 veces por segundo cu\xE1ntos bits entreg\xF3\nel detector de tramas\
      \ (nitems_written del\nbloque \"detector_trama\")."
    function_args: '0'
    function_name: nitems_written
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 776.0]
    rotation: 0
    state: enabled
- name: items_ok
  id: variable_function_probe
  parameters:
    block_id: crc
    comment: "Lee 2 veces por segundo cu\xE1ntos bytes ya\nsalieron del CRC (funci\xF3\
      n nitems_written del\nbloque \"crc\")."
    function_args: '0'
    function_name: nitems_written
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 776.0]
    rotation: 0
    state: enabled
- name: lbl_ber
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el BER que da la teor\xEDa\npara ese Eb/N0."
    formatter: 'lambda x: ''%.1e'' % x if x == x else ''-'''
    gui_hint: 2,3,1,1
    label: "BER te\xF3rico (Eb/N0 est.): "
    type: real
    value: ber_est
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2472, 424.0]
    rotation: 0
    state: enabled
- name: lbl_cfo
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el desv\xEDo de frecuencia\nde la se\xF1al recibida,\
      \ en Hz."
    formatter: 'lambda x: ''%.0f Hz'' % x'
    gui_hint: 1,3,1,1
    label: "Desv\xEDo de frecuencia: "
    type: real
    value: cfo_hz
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1672, 424.0]
    rotation: 0
    state: enabled
- name: lbl_detectadas
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana cu\xE1ntas tramas se\ndetectaron (pre\xE1mbulo\
      \ encontrado), est\xE9n bien\no mal."
    formatter: None
    gui_hint: 0,4,1,1
    label: 'Tramas detectadas: '
    type: int
    value: tramas_detectadas
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2200, 248.0]
    rotation: 0
    state: enabled
- name: lbl_ebn0
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el Eb/N0 que se estima\ncon los s\xEDmbolos recibidos."
    formatter: "lambda x: '%.1f dB' % x if x == x else 'sin se\xF1al'"
    gui_hint: 2,2,1,1
    label: 'Eb/N0 estimado: '
    type: real
    value: eb_n0_db
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2200, 424.0]
    rotation: 0
    state: enabled
- name: lbl_mal
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana cu\xE1ntas tramas se\ndetectaron pero el CRC descart\xF3\
      ."
    formatter: None
    gui_hint: 2,1,1,1
    label: 'Descartadas por CRC: '
    type: int
    value: max(tramas_detectadas - paquetes_ok, 0)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 424.0]
    rotation: 0
    state: enabled
- name: lbl_ok
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana cu\xE1ntos paquetes pasaron\nel CRC (llegaron\
      \ sin errores)."
    formatter: None
    gui_hint: 2,0,1,1
    label: 'Con CRC correcto: '
    type: int
    value: paquetes_ok
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2472, 248.0]
    rotation: 0
    state: enabled
- name: lbl_per
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el PER (fracci\xF3n de\npaquetes perdidos) que\
      \ da la teor\xEDa para ese\nEb/N0."
    formatter: 'lambda x: ''%.1e'' % x if x == x else ''-'''
    gui_hint: 2,4,1,1
    label: "PER te\xF3rico (Eb/N0 est.): "
    type: real
    value: per_est
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1400, 584.0]
    rotation: 0
    state: enabled
- name: lbl_ppm
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el mismo desv\xEDo en ppm\n(Hz por cada MHz de\
      \ portadora): cu\xE1nto\ndifieren los relojes de las dos HackRF."
    formatter: 'lambda x: ''%.1f'' % x'
    gui_hint: 1,4,1,1
    label: "Desv\xEDo [ppm]: "
    type: real
    value: cfo_hz / freq_mhz
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1936, 424.0]
    rotation: 0
    state: enabled
- name: lna
  id: variable_qtgui_range
  parameters:
    comment: 'Control de la ventana: ganancia del LNA

      (primer amplificador del RX), de 0 a 40 dB en

      pasos de 8.'
    gui_hint: 0,2,1,1
    label: Ganancia LNA [dB]
    min_len: '120'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '8'
    stop: '40'
    value: '16'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1936, 8.0]
    rotation: 0
    state: enabled
- name: p_est
  id: variable
  parameters:
    comment: "Probabilidad de que un s\xEDmbolo se decida mal\nen un eje: p = Q(ra\xED\
      z(2 Eb/N0))."
    value: 0.5 * math.erfc(math.sqrt(10 ** (eb_n0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1088.0]
    rotation: 0
    state: enabled
- name: paquetes_ok
  id: variable
  parameters:
    comment: 'Paquetes con CRC correcto = bytes que salieron

      del CRC / (N + 2).'
    value: int(items_ok) // (N + 2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 952.0]
    rotation: 0
    state: enabled
- name: per_est
  id: variable
  parameters:
    comment: "PER te\xF3rico: probabilidad de que una trama de\n8 \xD7 (N + 18) bits\
      \ tenga alg\xFAn error = 1 - (1 -\np)^bits."
    value: 1 - (1 - p_est) ** (8 * (N + 18))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 1088.0]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: "Constelaci\xF3n 4-QAM: 4 puntos (\xB10,707 \xB1 j0,707)\ncon c\xF3digo\
      \ Gray (Symbol Map 0, 1, 3, 2), la\nmisma del transmisor. La usa el decisor."
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 8.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: 'Muestreo de la HackRF: 2 M muestras por

      segundo (igual que en el transmisor).'
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 248.0]
    rotation: 0
    state: enabled
- name: samp_rate_rx
  id: variable
  parameters:
    comment: "Muestreo despu\xE9s del diezmado: 1 M muestras/s.\nLo usan los bloques\
      \ del receptor."
    value: samp_rate / decim
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 248.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "Muestras por s\xEDmbolo en el receptor: 4 (1 M /\n4 = 250 000 s\xED\
      mbolos/s, como en el\ntransmisor)."
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 248.0]
    rotation: 0
    state: enabled
- name: sync_bw
  id: variable_qtgui_range
  parameters:
    comment: "Control de la ventana: ancho de banda del lazo\ndel sincronismo de s\xED\
      mbolo."
    gui_hint: 1,2,1,1
    label: "BW sinc. de s\xEDmbolo"
    min_len: '100'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.001'
    step: '0.001'
    stop: '0.1'
    value: '0.01'
    widget: counter
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1936, 224.0]
    rotation: 0
    state: enabled
- name: taps_canal
  id: variable
  parameters:
    comment: "Coeficientes del filtro pasabajos del canal:\ncorte en 300 kHz y transici\xF3\
      n de 100 kHz. Deja\npasar la se\xF1al (\xB1170 kHz, con hasta 40 kHz de\ndesv\xED\
      o) y quita el pico del centro y lo dem\xE1s."
    value: firdes.low_pass(1, samp_rate, 300e3, 100e3)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1112, 56.0]
    rotation: 0
    state: enabled
- name: tramas_detectadas
  id: variable
  parameters:
    comment: "Tramas detectadas = bits que entreg\xF3 el\ndetector / bits de cada\
      \ trama (8 \xD7 (N + 6))."
    value: int(items_detectados) // (8 * (N + 6))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 952.0]
    rotation: 0
    state: enabled
- name: umbral
  id: variable
  parameters:
    comment: "Cu\xE1ntos bits del pre\xE1mbulo (de 64) pueden\nllegar mal y aun as\xED\
      \ se acepta la trama."
    value: '12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 392.0]
    rotation: 0
    state: enabled
- name: vga_rx
  id: variable_qtgui_range
  parameters:
    comment: 'Control de la ventana: ganancia del VGA

      (amplificador variable del RX), de 0 a 62 dB

      en pasos de 2.'
    gui_hint: 0,3,1,1
    label: Ganancia VGA [dB]
    min_len: '120'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '2'
    stop: '62'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2200, 8.0]
    rotation: 0
    state: enabled
- name: w_costas
  id: variable_function_probe
  parameters:
    block_id: costas_sonda
    comment: "Lee 2 veces por segundo la correcci\xF3n promedio\nde Costas (bloque\
      \ \"costas_sonda\"), en radianes\npor s\xEDmbolo."
    function_args: ''
    function_name: level
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 776.0]
    rotation: 0
    state: enabled
- name: w_fll
  id: variable_function_probe
  parameters:
    block_id: fll_sonda
    comment: "Lee 2 veces por segundo la correcci\xF3n promedio\ndel FLL (bloque \"\
      fll_sonda\"), en radianes por\nmuestra."
    function_args: ''
    function_name: level
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [808, 776.0]
    rotation: 0
    state: enabled
- name: a_bits
  id: blocks_unpack_k_bits_bb
  parameters:
    affinity: ''
    alias: ''
    comment: "Separa cada n\xFAmero en sus 2 bits (primero el\nm\xE1s significativo).\n\
      Entra: bytes con 2 bits \xFAtiles (0 a 3), 250\n  k/s.\nSale: bits sueltos (1\
      \ bit por byte: 0 o 1),\n  500 k/s."
    k: '2'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3008, 2584.0]
    rotation: 0
    state: enabled
- name: a_bytes
  id: blocks_repack_bits_bb
  parameters:
    affinity: ''
    alias: ''
    align_output: 'True'
    comment: "Junta los bits de a 8 para volver a formar\nbytes, respetando d\xF3\
      nde empieza cada paquete\n(packet_len).\nEntra: bits sueltos (1 por byte).\n\
      Sale: bytes: N + 6 por paquete (packet_len)."
    endianness: gr.GR_MSB_FIRST
    k: '1'
    l: '8'
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '70000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 3112.0]
    rotation: 0
    state: enabled
- name: acelerador
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: "(Deshabilitado) Frena la lectura de la\ngrabaci\xF3n a 2 M muestras/s,\
      \ la velocidad real\nde la HackRF.\nEntra: complejos.\nSale: los mismos complejos,\
      \ a 2 M muestras/s."
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 2312.0]
    rotation: 0
    state: disabled
- name: agc
  id: analog_agc2_xx
  parameters:
    affinity: ''
    alias: ''
    attack_rate: 1e-2
    comment: "Control autom\xE1tico de\nganancia: sube o baja la\nganancia para que\
      \ la se\xF1al\ntenga nivel 1, llegue fuerte\no d\xE9bil.\nEntra: complejos a\
      \ 1 M\n  muestras/s.\nSale: complejos a 1 M\n  muestras/s, con nivel 1."
    decay_rate: 1e-3
    gain: '1.0'
    max_gain: '65536'
    maxoutbuf: '0'
    minoutbuf: '0'
    reference: '1.0'
    type: complex
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 2552.0]
    rotation: 0
    state: enabled
- name: alto_f
  id: blocks_uchar_to_float
  parameters:
    affinity: ''
    alias: ''
    comment: "Pasa el byte alto (0 a 255) a n\xFAmero real,\npara hacer cuentas.\n\
      Entra: bytes.\nSale: reales."
