- name: mapa_gray
  id: digital_map_bb
  parameters:
    affinity: ''
    alias: ''
    comment: "Deshace el c\xF3digo Gray: cambia cada s\xEDmbolo\npor los 2 bits que\
      \ mand\xF3 el transmisor (0->0,\n1->1, 2->3, 3->2).\nEntra: s\xEDmbolos 0 a\
      \ 3 (bytes).\nSale: n\xFAmeros 0 a 3 = 2 bits de datos (bytes)."
    map: '[0, 1, 3, 2]'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
