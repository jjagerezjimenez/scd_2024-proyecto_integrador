options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: "Opciones del flowgraph: t\xEDtulo de la ventana,\ninterfaz QT GUI y\
      \ nombre del programa que arma\nGRC al apretar F6 (hackrf_tx_archivo.py, en\n\
      esta misma carpeta)."
    copyright: ''
    description: "Transmite un archivo en paquetes numerados (CRC-32, pre\xE1mbulo\
      \ y longitud) con 4-QAM diferencial por un HackRF; solo bloques est\xE1ndar\
      \ de GNU Radio"
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hackrf_tx_archivo
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "HackRF TX: transmisi\xF3n de un archivo (4-QAM, bloques est\xE1ndar)"
    window_size: (1850, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 32.0]
    rotation: 0
    state: enabled

blocks:
- name: N
  id: variable
  parameters:
    comment: "Bytes del archivo en cada paquete. Tiene que\nser el mismo n\xFAmero\
      \ en el receptor."
    value: '200'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 264.0]
    rotation: 0
    state: enabled
- name: W
  id: variable
  parameters:
    comment: 'Bytes de relleno al azar al comienzo de cada

      pasada (2500 bytes = 40 ms): le dan tiempo al

      receptor para engancharse.'
    value: '2500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 264.0]
    rotation: 0
    state: enabled
- name: amp_tx
  id: variable_qtgui_check_box
  parameters:
    comment: 'Casilla de la ventana: prende el amplificador

      extra del TX (+14 dB). Empezar con la casilla

      apagada; nunca prenderla con un cable sin

      atenuador.'
    'false': 'False'
    gui_hint: 0,2,1,1
    label: Amplificador TX (+14 dB)
    'true': 'True'
    type: bool
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 1000.0]
    rotation: 0
    state: enabled
- name: amplitud
  id: variable_qtgui_range
  parameters:
    comment: "Control de la ventana: n\xFAmero por el que se\nmultiplica la se\xF1\
      al antes de la HackRF. Los\npicos de I y Q tienen que quedar debajo de 1:\n\
      usar 0,6 como m\xE1ximo."
    gui_hint: 0,3,1,1
    label: Amplitud digital (pico < 1)
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.05'
    step: '0.05'
    stop: '0.7'
    value: '0.5'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 992.0]
    rotation: 0
    state: enabled
- name: bytes_pasada
  id: variable
  parameters:
    comment: 'Bytes de una pasada: relleno W + n_paq tramas.'
    value: W + n_paq * bytes_trama
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 800.0]
    rotation: 0
    state: enabled
- name: bytes_trama
  id: variable
  parameters:
    comment: "Bytes de cada trama: pre\xE1mbulo 8 + longitud 4\n+ n\xFAmero 2 + datos\
      \ N + CRC 4 = N + 18."
    value: N + 18
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 632.0]
    rotation: 0
    state: enabled
- name: contenido
  id: variable
  parameters:
    comment: "Bytes del archivo, como lista de n\xFAmeros de 0\na 255 (se lee entero\
      \ al abrir el flowgraph).\nSi no existe: el texto \"No se encontro el\narchivo\
      \ ...\"."
    value: list(open(archivo, "rb").read()) if encontrado else list(("No se encontro
      el archivo " + archivo).encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 448.0]
    rotation: 0
    state: enabled
- name: datos
  id: variable
  parameters:
    comment: "Datos de una pasada: el archivo (completado\ncon ceros hasta llenar\
      \ el \xFAltimo paquete) + el\npaquete de descripci\xF3n. Son n_paq \xD7 N bytes."
    value: contenido + [0] * (n_datos * N - len(contenido)) + (descripcion + [0] *
      N)[:N]
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 632.0]
    rotation: 0
    state: enabled
- name: descripcion
  id: variable
  parameters:
    comment: "Contenido del \xFAltimo paquete de cada pasada:\nARCHIVO|nombre (hasta\
      \ 40\nbytes)|tama\xF1o|N|paquetes|huella|. Con \xE9l,\nreconstruir_archivo.py\
      \ sabe c\xF3mo armar el\narchivo."
    value: list(b"ARCHIVO|" + nombre.encode()[:40] + ("|%d|%d|%d|%s|" % (len(contenido),
      N, n_paq, huella)).encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 632.0]
    rotation: 0
    state: enabled
- name: dispositivo
  id: variable
  parameters:
    comment: "Qu\xE9 HackRF usar: \"serial=...\" (el n\xFAmero lo\nmuestra hackrf_info).\
      \ Vac\xEDo = la primera que\nencuentre."
    value: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 56.0]
    rotation: 0
    state: enabled
- name: duracion_pasada
  id: variable
  parameters:
    comment: "Segundos que dura una pasada en el aire (8\nbits por byte, 2 bits por\
      \ s\xEDmbolo, 250 000\ns\xEDmbolos/s)."
    value: bytes_pasada * 8 / 2 / (samp_rate / sps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 800.0]
    rotation: 0
    state: enabled
- name: encontrado
  id: variable
  parameters:
    comment: 'True si el archivo existe. Si no existe, en su

      lugar se manda un texto de aviso.'
    value: os.path.isfile(archivo)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 448.0]
    rotation: 0
    state: enabled
- name: enviados
  id: variable_function_probe
  parameters:
    block_id: limite
    comment: "Lee 2 veces por segundo cu\xE1ntos bytes ya\nsalieron del bloque \"\
      limite\" (Head), con su\nfunci\xF3n nitems_written. Con eso se cuentan las\n\
      pasadas."
    function_args: '0'
    function_name: nitems_written
    poll_rate: '2'
    value: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1208.0]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: "Roll-off del filtro RRC (0,35): cu\xE1nto m\xE1s\nancho que el m\xED\
      nimo es el espectro. La se\xF1al\nocupa 250 k \xD7 1,35 \u2248 340 kHz."
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 264.0]
    rotation: 0
    state: enabled
- name: f_offset
  id: variable
  parameters:
    comment: "Corrimiento digital de 400 kHz: la HackRF se\nsintoniza 400 kHz m\xE1\
      s abajo y la se\xF1al se\ncorre +400 kHz. As\xED el pico que deja la placa\n\
      en el centro del espectro queda fuera de la\nse\xF1al."
    value: 400e3
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 264.0]
    rotation: 0
    state: enabled
- name: formato_trama
  id: variable_header_format_default
  parameters:
    access_code: '0'
    bps: '1'
    comment: "Formato del encabezado de cada trama:\npre\xE1mbulo de 64 bits (Access\
      \ Code 0 = el\npre\xE1mbulo est\xE1ndar de GNU Radio) + longitud\ndel paquete\
      \ en 16 bits, escrita 2 veces. Lo\nusa el Protocol Formatter."
    threshold: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 432.0]
    rotation: 0
    state: enabled
- name: freq_mhz
  id: variable_qtgui_entry
  parameters:
    comment: 'Casilla de la ventana: frecuencia de la

      portadora en MHz. Se aplica al apretar Enter.

      La HackRF se sintoniza en esta frecuencia -

      400 kHz (ver f_offset).'
    entry_signal: editingFinished
    gui_hint: 0,0,1,1
    label: Frecuencia [MHz]
    type: real
    value: '915'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1016.0]
    rotation: 0
    state: enabled
- name: huella
  id: variable
  parameters:
    comment: "Huella SHA-256 del archivo (64 caracteres): el\nreceptor la usa para\
      \ comprobar que el archivo\nlleg\xF3 id\xE9ntico."
    value: hashlib.sha256(bytes(contenido)).hexdigest()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 448.0]
    rotation: 0
    state: enabled
- name: lbl_archivo
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana el nombre y el tama\xF1o\ndel archivo que se transmite."
    formatter: None
    gui_hint: 1,0,1,1
    label: 'Archivo: '
    type: string
    value: '"%s (%d bytes)" % (nombre, len(contenido))'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 1216.0]
    rotation: 0
    state: enabled
- name: lbl_huella
  id: variable_qtgui_label
  parameters:
    comment: 'Muestra en la ventana el comienzo de la huella

      SHA-256 del archivo.'
    formatter: None
    gui_hint: 1,2,1,1
    label: 'SHA-256: '
    type: string
    value: huella[:16] + "..."
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [800, 1216.0]
    rotation: 0
    state: enabled
- name: lbl_paquetes
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana cu\xE1ntos paquetes tiene\ncada pasada y cu\xE1\
      ntos segundos dura."
    formatter: None
    gui_hint: 1,1,1,1
    label: 'Paquetes por pasada: '
    type: string
    value: '"%d (%.2f s cada pasada)" % (n_paq, duracion_pasada)'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 1216.0]
    rotation: 0
    state: enabled
- name: lbl_pasadas
  id: variable_qtgui_label
  parameters:
    comment: "Muestra en la ventana cu\xE1ntas pasadas ya se\nmandaron (bytes que\
      \ salieron / bytes por\npasada). Va unos 0,5 s adelantado: hay\nmuestras esperando\
      \ en los buffers."
    formatter: 'lambda x: ''%.2f'' % x'
    gui_hint: 1,3,1,1
    label: 'Pasadas enviadas: '
    type: real
    value: min(enviados, total_bytes - W) / bytes_pasada
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1056, 1216.0]
    rotation: 0
    state: enabled
- name: n_datos
  id: variable
  parameters:
    comment: "Cu\xE1ntos paquetes de N bytes hacen falta para\nel archivo (redondeando\
      \ hacia arriba)."
    value: (len(contenido) + N - 1) // N
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 448.0]
    rotation: 0
    state: enabled
- name: n_paq
  id: variable
  parameters:
    comment: "Paquetes por pasada: los de datos + 1 final\nque describe el archivo\
      \ (nombre, tama\xF1o y\nhuella)."
    value: n_datos + 1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 632.0]
    rotation: 0
    state: enabled
- name: nombre
  id: variable
  parameters:
    comment: "Nombre del archivo sin la carpeta (viaja en el\n\xFAltimo paquete).\
      \ Si no existe:\nERROR_archivo_no_encontrado.txt"
    value: os.path.basename(archivo) if encontrado else "ERROR_archivo_no_encontrado.txt"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 448.0]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: "Constelaci\xF3n 4-QAM: 4 puntos (\xB10,707 \xB1 j0,707)\ncon c\xF3digo\
      \ Gray (Symbol Map 0, 1, 3, 2: los\nvecinos difieren en un solo bit). La usa\
      \ el\nmodulador."
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    imag_sect: '2'
    precision: '8'
    real_sect: '2'
    rot_sym: '4'
    soft_dec_lut: None
    sym_map: '[0, 1, 3, 2]'
    w_imag_sect: '1'
    w_real_sect: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1344, 8.0]
    rotation: 0
    state: enabled
- name: relleno
  id: variable
  parameters:
    comment: "W bytes al azar (siempre los mismos: semilla\n1). No llevan pre\xE1\
      mbulo, as\xED que el receptor\nno los toma como tramas."
    value: list(random.Random(1).randbytes(W))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1080, 632.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: "Muestreo: 2 M muestras por segundo (2 MHz de\nbanda). Lo usan la HackRF,\
      \ el Rotator y los\ngr\xE1ficos. 2 M es lo m\xEDnimo recomendado para la\nHackRF."
    value: 2e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 264.0]
    rotation: 0
    state: enabled
- name: secuencia
  id: variable
  parameters:
    comment: "N\xFAmeros de paquete de una pasada: 0, 1, 2, ...\nn_paq - 1, cada uno\
      \ en 2 bytes (primero el\nbyte alto)."
    value: '[b for i in range(n_paq) for b in ((i // 256) % 256, i % 256)]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 632.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: "Muestras por s\xEDmbolo en el TX. 2 M / 8 = 250\n000 s\xEDmbolos/s;\
      \ con 2 bits por s\xEDmbolo son 500\nkbit/s."
    value: '8'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 264.0]
    rotation: 0
    state: enabled
- name: total_bytes
  id: variable
  parameters:
    comment: "Bytes que deja pasar el Head: \"repeticiones\"\npasadas + un relleno\
      \ final (para que la \xFAltima\ntrama salga entera). Con repeticiones = 0 no\n\
      hay l\xEDmite (2^62)."
    value: repeticiones * bytes_pasada + W if repeticiones > 0 else 2**62
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 800.0]
    rotation: 0
    state: enabled
- name: vga_tx
  id: variable_qtgui_range
  parameters:
    comment: 'Control de la ventana: ganancia del

      amplificador variable (VGA) del TX de la

      HackRF, de 0 a 47 dB. Se puede cambiar

      mientras transmite.'
    gui_hint: 0,1,1,1
    label: Ganancia TX (VGA) [dB]
    min_len: '150'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '47'
    value: '20'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 992.0]
    rotation: 0
    state: enabled
- name: ajuste_amplitud
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: "Multiplica la se\xF1al por la\n\"amplitud\" de la ventana,\npara que\
      \ los picos de I y\nQ no pasen de \xB11 (si\npasan, el DAC de la HackRF\nrecorta).\n\
      Entra: complejos.\nSale: complejos escalados\n  (van a la HackRF y a los\n \
      \ gr\xE1ficos)."
    const: amplitud
    maxoutbuf: '0'
    minoutbuf: '0'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1424, 2296.0]
    rotation: 0
    state: enabled
- name: archivo
  id: parameter
  parameters:
    alias: ''
    comment: "Par\xE1metro: archivo que se transmite (ruta\ndesde la carpeta de este\
      \ .grc, con barras /).\nTambi\xE9n se puede elegir al correr el .py:\n--archivo\
      \ foto.jpg"
    hide: none
    label: Archivo a transmitir
    short_id: ''
    type: str
    value: archivo_a_enviar.txt
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 40.0]
    rotation: 0
    state: enabled
- name: crc
  id: digital_crc32_bb
  parameters:
    affinity: ''
    alias: ''
    check: 'False'
    comment: "Calcula el CRC-32 de cada paquete y se lo\nagrega al final (4 bytes).\
      \ El receptor lo\nvuelve a calcular para descartar los paquetes\ncon errores.\n\
      Entra: bytes: paquete de N + 2 bytes\n  (packet_len).\nSale: bytes: paquete\
      \ + CRC = N + 6 bytes\n  (packet_len)."
    lengthtagname: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packed: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [864, 1656.0]
    rotation: 0
    state: enabled
- name: datos_fuente
  id: blocks_vector_source_x
  parameters:
    affinity: ''
    alias: ''
    comment: "Entrega una y otra vez la lista \"datos\": el\narchivo + el paquete\
      \ de descripci\xF3n.\nEntra: nada (es una fuente).\nSale: bytes del archivo."
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat: 'True'
    tags: '[]'
    type: byte
    vector: datos
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 1896.0]
    rotation: 0
    state: enabled
- name: datos_paquetes
  id: blocks_stream_to_tagged_stream
  parameters:
    affinity: ''
    alias: ''
    comment: "Corta los datos en grupos de N = 200 bytes\n(uno por paquete) marcados\
      \ con packet_len =\n200.\nEntra: bytes sin marcas.\nSale: los mismos bytes,\
      \ en grupos de N\n  marcados con packet_len."
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
    packet_len: N
    type: byte
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 1904.0]
    rotation: 0
    state: enabled
- name: desplazar
  id: blocks_rotator_cc
  parameters:
    affinity: ''
    alias: ''
    comment: "Corre la se\xF1al +400 kHz en frecuencia (la\nmultiplica por una exponencial\
      \ compleja). As\xED\nqueda lejos del pico que deja la HackRF en el\ncentro.\n\
      Entra: complejos a 2 M muestras/s, centrados\n  en 0 Hz.\nSale: complejos a\
      \ 2 M muestras/s, centrados en\n  +400 kHz."
    maxoutbuf: '0'
    minoutbuf: '0'
    phase_inc: 2 * math.pi * f_offset / samp_rate
    tag_inc_update: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 2288.0]
    rotation: 0
    state: enabled
- name: encabezado
  id: digital_protocol_formatter_bb
  parameters:
    affinity: ''
    alias: ''
    comment: "Arma el encabezado de cada paquete\ncon el formato \"formato_trama\"\
      :\npre\xE1mbulo de 64 bits + longitud (2\nveces). Solo produce el\nencabezado,\
      \ no copia el paquete.\nEntra: bytes: paquete con CRC\n  (packet_len).\nSale:\
      \ bytes: encabezado de 12\n  bytes (packet_len = 12)."
    format: formato_trama
    len_tag_key: '"packet_len"'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1128, 1432.0]
    rotation: 0
    state: enabled
- name: g_cascada
  id: qtgui_waterfall_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    axislabels: 'True'
    bw: samp_rate
    color1: '0'
    color10: '0'
    color2: '0'
    color3: '0'
    color4: '0'
    color5: '0'
    color6: '0'
    color7: '0'
    color8: '0'
    color9: '0'
    comment: "Gr\xE1fico de cascada: el espectro a lo largo del\ntiempo (cada l\xED\
      nea es un instante; el color,\nla potencia).\nEntra: complejos a 2 M muestras/s.\n\
      Sale: nada (solo dibuja)."
    fc: '0'
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'False'
    gui_hint: 2,1,1,1
    int_max: '0'
    int_min: '-120'
    label1: ''
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
