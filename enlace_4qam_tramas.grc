options:
  parameters:
    author: Juan Gerez
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Enlace 4-QAM con tramas (preámbulo + longitud + CRC-32) y medición de BER, solo bloques estándar de GNU Radio
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: enlace_4qam_tramas
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Enlace 4-QAM con tramas y BER (bloques estándar)
    window_size: (1800, 1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: imports
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math, cmath
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1120, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Frecuencia de muestreo [muestras/s]
    value: '500000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: Muestras por símbolo
    value: '4'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [296, 12]
    rotation: 0
    state: enabled
- name: excess_bw
  id: variable
  parameters:
    comment: Factor de roll-off del filtro RRC
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [376, 12]
    rotation: 0
    state: enabled
- name: mensaje
  id: variable
  parameters:
    comment: Texto que viaja en el payload de cada trama
    value: '"Sistemas de Comunicaciones Digitales - FACET UNT - enlace 4-QAM half-duplex en GNU Radio!!!!!!!!"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 92]
    rotation: 0
    state: enabled
- name: payload
  id: variable
  parameters:
    comment: Payload como lista de bytes
    value: list(mensaje.encode())
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 92]
    rotation: 0
    state: enabled
- name: L
  id: variable
  parameters:
    comment: Bytes de payload por trama
    value: len(payload)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 92]
    rotation: 0
    state: enabled
- name: bits_trama
  id: variable
  parameters:
    comment: Preámbulo 64 b + longitud 2x16 b + payload + CRC-32
    value: 8*(8 + 4 + L + 4)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 92]
    rotation: 0
    state: enabled
- name: qpsk
  id: variable_constellation_rect
  parameters:
    comment: ''
    const_points: '[-0.707-0.707j, 0.707-0.707j, +0.707+0.707j, -0.707+0.707j]'
    sym_map: '[0, 1, 3, 2]'
    rot_sym: '4'
    real_sect: '2'
    imag_sect: '2'
    w_real_sect: '1'
    w_imag_sect: '1'
    precision: '8'
    soft_dec_lut: None
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 12]
    rotation: 0
    state: enabled
- name: formato_trama
  id: variable_header_format_default
  parameters:
    comment: ''
    access_code: '0'
    threshold: '0'
    bps: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 12]
    rotation: 0
    state: enabled
- name: umbral
  id: variable
  parameters:
    comment: Bits erróneos tolerados al buscar el preámbulo de 64 bits
    value: '12'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 92]
    rotation: 0
    state: enabled
- name: ruido
  id: variable
  parameters:
    comment: 'Desvío del ruido complejo: potencia de señal = 1 por muestra, Es/N0 = 2 Eb/N0'
    value: math.sqrt(sps / (2 * 10**(ebn0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 172]
    rotation: 0
    state: enabled
- name: p_qpsk
  id: variable
  parameters:
    comment: 'Q(raiz(2 Eb/N0)): 4-QAM coherente'
    value: 0.5 * math.erfc(math.sqrt(10**(ebn0_db / 10)))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 172]
    rotation: 0
    state: enabled
- name: ber_teo
  id: variable
  parameters:
    comment: '4-QAM con codificación diferencial: 2p(1-p)'
    value: 2 * p_qpsk * (1 - p_qpsk)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 172]
    rotation: 0
    state: enabled
- name: ventana
  id: variable
  parameters:
    comment: Bits de la ventana del BER 'reciente'
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 172]
    rotation: 0
    state: enabled
- name: ebn0_db
  id: variable_qtgui_range
  parameters:
    comment: ''
    label: Eb/N0 [dB]
    rangeType: float
    value: '10'
    start: '0'
    stop: '15'
    step: '0.5'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '150'
    gui_hint: 0,0,1,2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 12]
    rotation: 0
    state: enabled
- name: fase_deg
  id: variable_qtgui_range
  parameters:
    comment: ''
    label: Fase del canal [°]
    rangeType: float
    value: '0'
    start: '-180'
    stop: '180'
    step: '1'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '150'
    gui_hint: 0,2,1,2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 12]
    rotation: 0
    state: enabled
- name: cfo_hz
  id: variable_qtgui_range
  parameters:
    comment: ''
    label: CFO [Hz]
    rangeType: float
    value: '0'
    start: '-1000'
    stop: '1000'
    step: '10'
    widget: counter_slider
    orient: QtCore.Qt.Horizontal
    min_len: '150'
    gui_hint: 0,4,1,2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1568, 12]
    rotation: 0
    state: enabled
- name: costas_bw
  id: variable_qtgui_range
  parameters:
    comment: ''
    label: BW lazo de Costas
    rangeType: float
    value: '0.005'
    start: '0.001'
    stop: '0.1'
    step: '0.001'
    widget: counter
    orient: QtCore.Qt.Horizontal
    min_len: '100'
    gui_hint: 1,0,1,1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 140]
    rotation: 0
    state: enabled
- name: sync_bw
  id: variable_qtgui_range
  parameters:
    comment: ''
    label: BW sinc. de símbolo
    rangeType: float
    value: '0.01'
    start: '0.001'
    stop: '0.1'
    step: '0.001'
    widget: counter
    orient: QtCore.Qt.Horizontal
    min_len: '100'
    gui_hint: 1,1,1,1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 140]
    rotation: 0
    state: enabled
- name: lbl_teo
  id: variable_qtgui_label
  parameters:
    comment: ''
    label: 'BER teórico: '
    type: real
    value: ber_teo
    formatter: 'lambda x: ''%.2e'' % x'
    gui_hint: 1,2,1,1
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1568, 140]
    rotation: 0
    state: enabled
- name: ber_acum_log
